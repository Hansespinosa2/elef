{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elef Stable Identity E2E",
  "identifier": "com.elef.desktop",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main-capability", "macos-updater-capability", "e2e-stable-webdriver"]
    }
  },
  "build": {
    "frontendDist": "../frontend/dist-e2e-stable",
    "beforeBuildCommand": "cd ../frontend && npm run build -- --profile=stable"
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
