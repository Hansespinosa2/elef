{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Named library and deck operations used by the Elef desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-choose-library-root",
    "allow-get-library-status",
    "allow-list-decks",
    "allow-create-deck",
    "allow-open-deck",
    "allow-rename-deck",
    "allow-delete-deck",
    "allow-save-source"
  ]
}
