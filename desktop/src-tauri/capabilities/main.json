{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Named library and deck operations used by the Elef desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:resources:allow-close",
    "allow-choose-library-root",
    "allow-get-library-status",
    "allow-read-library-config",
    "allow-write-library-config",
    "allow-read-authoring-registries",
    "allow-write-authoring-registry",
    "allow-list-decks",
    "allow-document-graph",
    "allow-create-deck",
    "allow-open-deck",
    "allow-read-deck-preview",
    "allow-read-source-snapshot",
    "allow-rename-deck",
    "allow-delete-deck",
    "allow-save-source",
    "allow-upload-asset",
    "allow-export-elef",
    "allow-import-elef",
    "allow-import-opened-elef",
    "allow-pending-open-elef-count",
    "allow-resolve-import-conflict",
    "allow-install-update",
    "updater:allow-check",
    "process:allow-restart"
  ]
}
