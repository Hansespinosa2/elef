#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
shell_name="${SHELL##*/}"
[[ "$shell_name" == bash ]] || {
  echo "install-agent-gh-auth: this installer currently supports Bash login shells" >&2
  exit 1
}

rc_file="$HOME/.bashrc"
source_file="$repo_root/scripts/agent-gh-auth.bash"
marker="# >>> Elef native agent GitHub auth >>>"

if [[ -f "$rc_file" ]] && grep -Fq "$marker" "$rc_file"; then
  echo "Agent GitHub wrappers are already installed in $rc_file"
  exit 0
fi

touch "$rc_file"
{
  printf '\n%s\n' "$marker"
  printf 'source %q\n' "$source_file"
  printf '%s\n' '# <<< Elef native agent GitHub auth <<<'
} >>"$rc_file"

echo "Installed agent GitHub wrappers in $rc_file"
echo "Restart Bash or run: source \"$rc_file\""
