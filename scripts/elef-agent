#!/usr/bin/env bash
set -euo pipefail

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Run from elef." >&2; exit 1; }
CONTAINER_CLI="${CONTAINER_CLI:-container}"
IMAGE_OVERRIDE="${ELEF_AGENT_IMAGE:-}"
CODEX_VERSION="${ELEF_AGENT_CODEX_VERSION:-0.153.1}"
CHROME_DEVTOOLS_MCP_VERSION="${ELEF_AGENT_CHROME_DEVTOOLS_MCP_VERSION:-1.8.0}"
WORKTREE_ROOT="${ELEF_WORKTREE_ROOT:-$(dirname "$REPO")/elef-worktrees}"
CODEX_HOME_HOST="${CODEX_HOME:-$HOME/.codex}"
GH_CONFIG_HOST="${GH_CONFIG_DIR:-$HOME/.config/gh}"
AGENT_STATE_ROOT="${ELEF_AGENT_STATE_ROOT:-$HOME/Library/Application Support/Elef/agent-router}"
CADDYFILE="${ELEF_AGENT_CADDYFILE:-$AGENT_STATE_ROOT/Caddyfile}"

die() { echo "error: $*" >&2; exit 1; }
need_container() { command -v "$CONTAINER_CLI" >/dev/null || die "Apple Container CLI not found"; }
safe_name() { [[ "${1:-}" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]$ ]] || die "invalid task name: ${1:-}"; }
worktree_for() { printf '%s/%s' "$WORKTREE_ROOT" "$1"; }
container_for() { printf 'elef-agent-%s' "$(host_for "$1")"; }
branch_for() { printf 'codex/%s' "$1"; }
route_for() { printf '%s/routes/%s' "$AGENT_STATE_ROOT" "$1"; }
host_for() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

image_for() {
  if [[ -n "$IMAGE_OVERRIDE" ]]; then
    printf '%s' "$IMAGE_OVERRIDE"
    return
  fi
  local digest
  digest="$({
    cat "$REPO/.devcontainer/Containerfile"
    cat "$REPO/.devcontainer/entrypoint.sh"
    cat "$REPO/.devcontainer/codex-config.toml"
    printf '%s:%s:%s:%s' "$(id -u)" "$(id -g)" "$CODEX_VERSION" "$CHROME_DEVTOOLS_MCP_VERSION"
  } | shasum | cut -c1-16)"
  printf 'elef-codex:%s' "$digest"
}

backend_port_for() {
  local task="$1" digest offset
  digest="$(printf '%s' "$task" | shasum | cut -c1-8)"
  offset=$((16#$digest % 900))
  printf '%s' "$((3100 + offset))"
}

router_ready() { command -v caddy >/dev/null 2>&1; }

render_routes() {
  local route task port
  mkdir -p "$AGENT_STATE_ROOT/routes"
  {
    echo '{'
    echo '  auto_https disable_redirects'
    echo '}'
    echo
    for route in "$AGENT_STATE_ROOT"/routes/*; do
      [[ -f "$route" ]] || continue
      task="$(basename "$route")"; port="$(<"$route")"
      cat <<EOF
https://${task}.localhost {
  bind 127.0.0.1
  tls internal
  reverse_proxy 127.0.0.1:${port}
}

EOF
    done
  } >"$CADDYFILE"
}

reload_router() {
  router_ready || die "Caddy is not installed; run '$0 setup' first"
  render_routes
  caddy reload --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 || \
    die "Caddy is not running; run '$0 setup' first"
}

setup() {
  if ! router_ready; then
    cat >&2 <<EOF
Caddy is required for worktree browser URLs.
Install it with:

  brew install caddy

Then run this command again. Caddy's local CA must also be trusted once:

  sudo caddy trust
EOF
    return 1
  fi
  mkdir -p "$AGENT_STATE_ROOT/routes"
  render_routes
  caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null || \
    die "invalid Caddy configuration: $CADDYFILE"
  local plist="$(mktemp -t elef-agent-router).plist"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.elef.agent-router</string>
  <key>ProgramArguments</key><array>
    <string>$(command -v caddy)</string><string>run</string>
    <string>--config</string><string>$CADDYFILE</string>
    <string>--adapter</string><string>caddyfile</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$AGENT_STATE_ROOT</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>$AGENT_STATE_ROOT</string>
    <key>XDG_CONFIG_HOME</key><string>$AGENT_STATE_ROOT/caddy-config</string>
    <key>XDG_DATA_HOME</key><string>$AGENT_STATE_ROOT/caddy-data</string>
  </dict>
  <key>StandardOutPath</key><string>$AGENT_STATE_ROOT/caddy.log</string>
  <key>StandardErrorPath</key><string>$AGENT_STATE_ROOT/caddy-error.log</string>
</dict></plist>
EOF
  sudo install -m 644 "$plist" /Library/LaunchDaemons/com.elef.agent-router.plist
  rm -f "$plist"
  sudo launchctl bootout system/com.elef.agent-router 2>/dev/null || true
  sudo launchctl bootstrap system /Library/LaunchDaemons/com.elef.agent-router.plist
  sudo launchctl kickstart -k system/com.elef.agent-router
  sudo install -d -m 755 "$AGENT_STATE_ROOT/caddy-config" "$AGENT_STATE_ROOT/caddy-data"
  sudo caddy trust --address 127.0.0.1:2019
  echo "Caddy is running on local HTTPS port 443."
  echo "Run '$0 start TASK' to create https://TASK.localhost."
}

build_image() {
  need_container
  local image="${1:-$(image_for)}"
  "$CONTAINER_CLI" build --tag "$image" \
    --build-arg "DEV_UID=$(id -u)" --build-arg "DEV_GID=$(id -g)" \
    --build-arg "CODEX_VERSION=$CODEX_VERSION" \
    --build-arg "CHROME_DEVTOOLS_MCP_VERSION=$CHROME_DEVTOOLS_MCP_VERSION" \
    --file "$REPO/.devcontainer/Containerfile" "$REPO"
}

image_exists() {
  "$CONTAINER_CLI" image inspect "$1" >/dev/null 2>&1
}

ensure_image() {
  local image="${1:-$(image_for)}"
  if image_exists "$image"; then
    echo "Reusing image $image"
  else
    echo "Building image $image"
    build_image "$image"
  fi
}

token_for_gh() {
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then printf '%s' "$GITHUB_TOKEN"
  elif [[ -n "${GH_TOKEN:-}" ]]; then printf '%s' "$GH_TOKEN"
  elif command -v gh >/dev/null 2>&1; then gh auth token 2>/dev/null || true
  fi
}

load_dotenv() {
  local env_file
  for env_file in "$REPO/.env" "$REPO/.env.local"; do
    if [[ -f "$env_file" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$env_file"
      set +a
    fi
  done
}

container_exists() {
  "$CONTAINER_CLI" inspect "$1" >/dev/null 2>&1
}

container_running() {
  "$CONTAINER_CLI" inspect "$1" 2>/dev/null | rg -q '"status"\s*:\s*"running"|"running"\s*:\s*true'
}

route_up() {
  local task="$1" port="$2" route
  route="$(route_for "$(host_for "$task")")"
  printf '%s' "$port" >"$route"
  if ! reload_router; then
    rm -f "$route"
    reload_router || true
    return 1
  fi
}

wait_for_http() {
  local task="$1" attempt code
  for attempt in {1..30}; do
    code="$(curl -k -sS -o /dev/null -w '%{http_code}' --max-time 2 "https://$(host_for "$task").localhost" 2>/dev/null || true)"
    if [[ "$code" =~ ^[1-5][0-9][0-9]$ ]]; then
      printf '%s' "$code"
      return 0
    fi
    sleep 1
  done
  return 1
}

report_readiness() {
  local task="$1" code="$2"
  if [[ "$code" -ge 500 ]]; then
    echo "Rails reachable at https://$(host_for "$task").localhost (HTTP $code); application is unhealthy" >&2
  else
    echo "Rails ready at https://$(host_for "$task").localhost (HTTP $code)"
  fi
}

run_container() {
  local task="$1" wt="$2" name="$3" token="$4" backend_port="$5" image="$6"
  local -a mounts=(--volume "$wt:$wt" --volume "$REPO/.git:$REPO/.git")
  [[ -f "$CODEX_HOME_HOST/auth.json" ]] && mounts+=(--volume "$CODEX_HOME_HOST/auth.json:/home/developer/.codex/auth.json:ro")
  [[ -f "$GH_CONFIG_HOST/hosts.yml" ]] && mounts+=(--volume "$GH_CONFIG_HOST/hosts.yml:/home/developer/.config/gh/hosts.yml:ro")
  "$CONTAINER_CLI" run --name "$name" --detach --init \
    --publish "127.0.0.1:${backend_port}:3000" \
    --env "GITHUB_TOKEN=$token" --env "GH_TOKEN=$token" \
    --env PORT=3000 --env BIND=0.0.0.0 \
    "${mounts[@]}" --workdir "$wt" "$image" web
}

start_task() {
  local task="$1" wt="$2" name="$3" token="$4" backend_port="$5" image="$6"
  run_container "$task" "$wt" "$name" "$token" "$backend_port" "$image"
  if ! route_up "$task" "$backend_port"; then
    "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
    "$CONTAINER_CLI" delete "$name" >/dev/null 2>&1 || true
    die "unable to register route for $task"
  fi
  local code
  if ! code="$(wait_for_http "$task")"; then
    local logs
    logs="$($CONTAINER_CLI logs "$name" 2>/dev/null || true)"
    "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
    "$CONTAINER_CLI" delete "$name" >/dev/null 2>&1 || true
    rm -f "$(route_for "$(host_for "$task")")"
    reload_router || true
    printf '%s\n' "$logs" | tail -40 >&2
    die "Rails did not become reachable for $task"
  fi
  report_readiness "$task" "$code"
}

start() {
  local task="${1:-}" base="${2:-HEAD}" wt name branch token backend_port host image
  [[ -n "$task" ]] || die "usage: elef-agent start TASK [BASE]"
  safe_name "$task"
  host="$(host_for "$task")"
  router_ready || die "Caddy is not installed; run '$0 setup' first"
  [[ ! "$host" =~ (^|\.)([.-]|$) ]] || die "task name cannot contain empty or hyphen-starting hostname labels: $task"
  load_dotenv
  token="$(token_for_gh)"
  [[ -n "$token" ]] || die "GitHub token unavailable; run 'gh auth login' or set GITHUB_TOKEN"
  wt="$(worktree_for "$task")"; name="$(container_for "$task")"; branch="$(branch_for "$task")"
  backend_port="$(backend_port_for "$task")"
  [[ ! -e "$wt" ]] || die "worktree already exists: $wt"
  need_container
  if ! container_running "$name" && lsof -nP -iTCP:"$backend_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "backend port is already in use: $backend_port"
  fi
  [[ ! -e "$(route_for "$host")" ]] || die "browser route already exists: https://${host}.localhost"
  "$CONTAINER_CLI" system start >/dev/null
  mkdir -p "$WORKTREE_ROOT"
  git worktree add -b "$branch" "$wt" "$base"
  image="$(image_for)"
  if ! ensure_image "$image"; then
    git worktree remove --force "$wt"
    git branch -D "$branch" >/dev/null 2>&1 || true
    die "unable to build image $image"
  fi
  start_task "$task" "$wt" "$name" "$token" "$backend_port" "$image"
  echo "Started $name"
  echo "Worktree: $wt"
  echo "Branch:   $branch"
  echo "Browser:  https://${host}.localhost"
}

up() {
  local task="${1:-}" wt name token backend_port host image
  [[ -n "$task" ]] || die "usage: elef-agent up TASK"
  safe_name "$task"
  wt="$(worktree_for "$task")"; name="$(container_for "$task")"; host="$(host_for "$task")"
  [[ -d "$wt" ]] || die "task worktree not found: $wt"
  router_ready || die "Caddy is not installed; run '$0 setup' first"
  load_dotenv
  token="$(token_for_gh)"; [[ -n "$token" ]] || die "GitHub token unavailable"
  backend_port="$(backend_port_for "$task")"
  if ! container_running "$name" && lsof -nP -iTCP:"$backend_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "backend port is already in use: $backend_port"
  fi
  "$CONTAINER_CLI" system start >/dev/null
  image="$(image_for)"
  ensure_image "$image"
  if container_exists "$name"; then
    if ! container_running "$name"; then
      # Recreate the disposable container so tasks created by older launcher
      # versions receive the managed web-process command as well.
      "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
      "$CONTAINER_CLI" delete "$name" >/dev/null 2>&1 || true
    fi
  fi
  container_running "$name" || run_container "$task" "$wt" "$name" "$token" "$backend_port" "$image"
  if ! route_up "$task" "$backend_port"; then
    "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
    "$CONTAINER_CLI" delete "$name" >/dev/null 2>&1 || true
    die "unable to register route for $task"
  fi
  local code
  if ! code="$(wait_for_http "$task")"; then
    "$CONTAINER_CLI" logs "$name" 2>/dev/null | tail -40 >&2 || true
    "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
    "$CONTAINER_CLI" delete "$name" >/dev/null 2>&1 || true
    rm -f "$(route_for "$host")"
    reload_router || true
    die "Rails did not become reachable for $task"
  fi
  report_readiness "$task" "$code"
}

exec_in() {
  local task="$1"; shift
  safe_name "$task"; need_container
  "$CONTAINER_CLI" exec --interactive --tty --workdir "$(worktree_for "$task")" "$(container_for "$task")" "$@"
}

status() {
  local route host port state code
  printf '%-32s %-10s %-8s %s\n' "TASK" "CONTAINER" "HTTP" "URL"
  for route in "$AGENT_STATE_ROOT"/routes/*; do
    [[ -f "$route" ]] || continue
    host="$(basename "$route")"; port="$(<"$route")"; state="stopped"; code="down"
    container_exists "$(container_for "$host")" && state="present"
    container_running "$(container_for "$host")" && state="running"
    code="$(curl -k -sS -o /dev/null -w '%{http_code}' --max-time 2 "https://${host}.localhost" 2>/dev/null || true)"
    [[ "$code" =~ ^[1-5][0-9][0-9]$ ]] || code="down"
    printf '%-32s %-10s %-8s https://%s.localhost\n' "$host" "$state" "$code" "$host"
  done
}

stop() {
  local task="${1:-}" host; [[ -n "$task" ]] || die "usage: elef-agent stop TASK"
  safe_name "$task"; host="$(host_for "$task")"; need_container
  "$CONTAINER_CLI" stop "$(container_for "$task")" || echo "warning: container may already be stopped" >&2
  rm -f "$(route_for "$host")"
  reload_router
}

remove() {
  local task="${1:-}" wt name host
  [[ -n "$task" ]] || die "usage: elef-agent remove TASK"
  safe_name "$task"; host="$(host_for "$task")"; need_container; wt="$(worktree_for "$task")"; name="$(container_for "$task")"
  "$CONTAINER_CLI" stop "$name" 2>/dev/null || true
  "$CONTAINER_CLI" delete "$name" 2>/dev/null || true
  rm -f "$(route_for "$host")"
  router_ready && reload_router || true
  [[ ! -e "$wt" ]] || git worktree remove --force "$wt"
  git branch -D "$(branch_for "$task")" 2>/dev/null || true
  echo "Removed container, worktree, and local branch for $task"
}

cleanup() {
  local task="${1:-}" wt name branch repo pr_state host
  [[ -n "$task" ]] || die "usage: elef-agent cleanup TASK"
  safe_name "$task"; host="$(host_for "$task")"; wt="$(worktree_for "$task")"; name="$(container_for "$task")"; branch="$(branch_for "$task")"
  [[ -e "$wt" ]] || die "worktree not found: $wt"
  [[ -z "$(git -C "$wt" status --porcelain)" ]] || die "worktree has uncommitted changes: $wt"
  command -v gh >/dev/null || die "GitHub CLI not found"
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" || die "unable to determine GitHub repository"
  pr_state="$(gh pr list --repo "$repo" --head "$branch" --state all --json state --jq '.[0].state // ""')"
  [[ "$pr_state" == "MERGED" ]] || die "refusing cleanup: PR for $branch is not merged"
  need_container
  "$CONTAINER_CLI" stop "$name" 2>/dev/null || true
  "$CONTAINER_CLI" delete "$name" 2>/dev/null || true
  rm -f "$(route_for "$host")"
  router_ready && reload_router || true
  git worktree remove "$wt"
  git branch -D "$branch"
  git push origin --delete "$branch"
  echo "Cleaned up merged task $task"
}

case "${1:-}" in
  setup) shift; setup "$@" ;;
  status) shift; status "$@" ;;
  start) shift; start "$@" ;;
  up) shift; up "$@" ;;
  shell) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent shell TASK [COMMAND...]"; task="$1"; shift; exec_in "$task" bash "$@" ;;
  codex) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent codex TASK [PROMPT...]"; task="$1"; shift; exec_in "$task" codex --dangerously-bypass-approvals-and-sandbox -m gpt-5.6-luna "$@" ;;
  resume) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent resume TASK"; task="$1"; shift; exec_in "$task" codex --dangerously-bypass-approvals-and-sandbox -m gpt-5.6-luna resume --last "$@" ;;
  stop) shift; stop "$@" ;;
  cleanup) shift; cleanup "$@" ;;
  remove) shift; remove "$@" ;;
  build) ensure_image ;;
  *) echo "usage: $0 {setup|status|start|up|codex|resume|shell|stop|cleanup|remove|build} TASK [ARGS...]" >&2; exit 2 ;;
esac
