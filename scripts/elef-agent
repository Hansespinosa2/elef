#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || {
  echo "Unable to locate the Elef repository from this script." >&2
  exit 1
}
REPO="$(cd -- "$SCRIPT_DIR/.." && pwd -P)" || { echo "Unable to locate the Elef repository." >&2; exit 1; }
cd "$REPO"
CONTAINER_CLI="${CONTAINER_CLI:-container}"
IMAGE_OVERRIDE="${ELEF_AGENT_IMAGE:-}"
CODEX_VERSION="${ELEF_AGENT_CODEX_VERSION:-latest}"
CODEX_MODEL="gpt-6-luna"
CHROME_DEVTOOLS_MCP_VERSION="${ELEF_AGENT_CHROME_DEVTOOLS_MCP_VERSION:-1.8.0}"
CONTAINER_MEMORY="${ELEF_AGENT_MEMORY:-1536M}"
AGENT_DATABASE="${ELEF_AGENT_DATABASE:-sqlite}"
WORKTREE_ROOT="${ELEF_WORKTREE_ROOT:-$(dirname "$REPO")/elef-worktrees}"
CODEX_HOME_HOST="${CODEX_HOME:-$HOME/.codex}"
DEVELOPMENT_SKILLS_HOST="$HOME/Development/GitHub/andy-skills/skills"
if [[ -n "${ELEF_USER_SKILLS_DIR:-}" ]]; then
  USER_SKILLS_HOST="$ELEF_USER_SKILLS_DIR"
elif [[ -d "$DEVELOPMENT_SKILLS_HOST" ]]; then
  USER_SKILLS_HOST="$DEVELOPMENT_SKILLS_HOST"
else
  USER_SKILLS_HOST="$CODEX_HOME_HOST/skills"
fi
GH_CONFIG_HOST="${GH_CONFIG_DIR:-$HOME/.config/gh}"
AGENT_STATE_ROOT="${ELEF_AGENT_STATE_ROOT:-$HOME/Library/Application Support/Elef/agent-router}"
CADDYFILE="${ELEF_AGENT_CADDYFILE:-$AGENT_STATE_ROOT/Caddyfile}"
STARTUP_TIMEOUT="${ELEF_AGENT_STARTUP_TIMEOUT:-300}"
STARTUP_LOG_PID=""
STARTUP_LOG_LINE_COUNT=0
STARTUP_BACKEND_CODE=000
STARTUP_ROUTE_CODE=000
STARTUP_HTTP_CODE=000
STARTUP_FAILURE_REASON=""

die() { echo "error: $*" >&2; exit 1; }
need_container() { command -v "$CONTAINER_CLI" >/dev/null || die "Apple Container CLI not found"; }
safe_name() { [[ "${1:-}" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]$ ]] || die "invalid task name: ${1:-}"; }
validate_agent_database() {
  case "$AGENT_DATABASE" in
    sqlite|postgres) ;;
    *) die "ELEF_AGENT_DATABASE must be sqlite or postgres (got: $AGENT_DATABASE)" ;;
  esac
}
validate_startup_timeout() {
  [[ "$STARTUP_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || \
    die "ELEF_AGENT_STARTUP_TIMEOUT must be a positive number of seconds (got: $STARTUP_TIMEOUT)"
}
registered_worktree_for() {
  local branch
  branch="refs/heads/$(branch_for "$1")"
  git worktree list --porcelain 2>/dev/null | awk -v branch="$branch" '
    /^worktree / { path = substr($0, 10) }
    $1 == "branch" && $2 == branch { print path; exit }
  '
}
worktree_for() {
  local preferred registered
  preferred="$WORKTREE_ROOT/$1"
  if worktree_is_valid "$1" "$preferred"; then
    (cd -- "$preferred" && pwd -P)
    return
  fi
  registered="$(registered_worktree_for "$1")"
  if [[ -n "$registered" ]] && worktree_is_valid "$1" "$registered"; then
    (cd -- "$registered" && pwd -P)
    return
  fi
  printf '%s' "$preferred"
}
container_for() { printf 'elef-agent-%s' "$(host_for "$1")"; }
branch_for() { printf 'codex/%s' "$1"; }
worktree_is_valid() {
  local task="$1" path="$2" canonical root branch repo_common task_common
  [[ -d "$path" ]] || return 1
  canonical="$(cd -- "$path" 2>/dev/null && pwd -P)" || return 1
  root="$(git -C "$canonical" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$root" == "$canonical" ]] || return 1
  branch="$(git -C "$canonical" symbolic-ref --quiet --short HEAD 2>/dev/null)" || return 1
  [[ "$branch" == "$(branch_for "$task")" ]] || return 1
  repo_common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  task_common="$(git -C "$canonical" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [[ "$task_common" == "$repo_common" ]]
}
require_worktree() {
  local task="$1" path registered
  path="$(worktree_for "$task")"
  worktree_is_valid "$task" "$path" && { printf '%s' "$path"; return; }
  registered="$(registered_worktree_for "$task")"
  if [[ -d "$path" ]]; then
    if [[ -n "$registered" ]]; then
      die "task directory is not a valid checkout for $(branch_for "$task"): $path. Git records the worktree at $registered; if it was moved, run: git worktree repair '$path'"
    fi
    die "task directory is not a valid checkout for $(branch_for "$task"): $path"
  fi
  if [[ -n "$registered" ]]; then
    die "task worktree is unavailable at $registered. Restore it or repair its Git worktree registration before resuming."
  fi
  die "task worktree not found: $path"
}
assert_task_branch_available() {
  local task="$1" branch registered
  branch="$(branch_for "$task")"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    registered="$(registered_worktree_for "$task")"
    if [[ -n "$registered" ]]; then
      if [[ ! -e "$registered" ]]; then
        die "branch $branch has a stale worktree record for missing path '$registered'. No state was changed; inspect 'git worktree list --porcelain' and recover this existing task before starting another task with the same name"
      fi
      if worktree_is_valid "$task" "$registered"; then
        die "task $task already exists at '$registered'; use '$0 up $task' to restart Rails or '$0 resume $task' to continue its Codex session"
      fi
      die "branch $branch is registered to '$registered', but that directory is not a valid task worktree; inspect it before pruning or recreating anything"
    fi
    die "branch $branch already exists without a registered task worktree; inspect it before reusing the task name"
  fi
}
route_for() { printf '%s/routes/%s' "$AGENT_STATE_ROOT" "$1"; }
codex_state_for() { printf '%s/codex/%s' "$AGENT_STATE_ROOT" "$1"; }
image_state_for() { printf '%s/images/%s' "$AGENT_STATE_ROOT" "$1"; }
database_state_for() { printf '%s/databases/%s' "$AGENT_STATE_ROOT" "$1"; }
terminal_state_for() { printf '%s/terminals/%s' "$AGENT_STATE_ROOT" "$1"; }
host_for() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

delete_codex_state() {
  local task="$1" state codex_root
  state="$(codex_state_for "$task")"
  codex_root="$AGENT_STATE_ROOT/codex"
  [[ "$state" == "$codex_root/"* ]] || die "refusing to delete unexpected Codex state path: $state"
  [[ "$state" != "$codex_root" && "$state" != "$codex_root/" ]] || die "refusing to delete Codex state root"
  [[ ! -L "$state" ]] || die "refusing to delete symlinked Codex state: $state"
  if [[ -d "$state" ]]; then
    rm -rf -- "$state"
    echo "Deleted Codex session state: $state"
  fi
}

image_for() {
  if [[ -n "$IMAGE_OVERRIDE" ]]; then
    printf '%s' "$IMAGE_OVERRIDE"
    return
  fi
  local digest
  digest="$({
    cat "$REPO/.devcontainer/Containerfile"
    cat "$REPO/.devcontainer/entrypoint.sh"
    cat "$REPO/.devcontainer/codex-config.toml"
    printf '%s:%s:%s:%s' "$(id -u)" "$(id -g)" "$CODEX_VERSION" "$CHROME_DEVTOOLS_MCP_VERSION"
  } | shasum | cut -c1-16)"
  printf 'elef-codex:%s' "$digest"
}

resolve_latest_codex() {
  [[ "$CODEX_VERSION" != "latest" ]] && return
  command -v npm >/dev/null || die "npm is required to resolve the latest Codex version"
  CODEX_VERSION="$(npm view @openai/codex version --silent)"
  [[ "$CODEX_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || \
    die "unable to resolve a valid Codex version"
}

new_image_for() {
  resolve_latest_codex
  image_for
}

remember_image() {
  local task="$1" image="$2" state
  state="$(image_state_for "$task")"
  mkdir -p "$(dirname "$state")"
  printf '%s\n' "$image" >"$state"
}

remember_database() {
  local task="$1" state
  validate_agent_database
  state="$(database_state_for "$task")"
  mkdir -p "$(dirname "$state")"
  printf '%s\n' "$AGENT_DATABASE" >"$state"
}

existing_image_for() {
  local task="$1" name image state
  state="$(image_state_for "$task")"
  if [[ -f "$state" ]]; then
    image="$(<"$state")"
    [[ -n "$image" ]] && { printf '%s' "$image"; return; }
  fi
  name="$(container_for "$task")"
  if container_exists "$name"; then
    command -v jq >/dev/null || die "jq is required to recover an existing task image"
    image="$("$CONTAINER_CLI" inspect "$name" | jq -r '.[0].configuration.image.reference // empty')"
    if [[ -n "$image" ]]; then
      remember_image "$task" "$image"
      printf '%s' "$image"
      return
    fi
  fi
  new_image_for
}

delete_image_state() {
  local task="$1" state
  state="$(image_state_for "$task")"
  [[ ! -L "$state" ]] || die "refusing to delete symlinked image state: $state"
  rm -f -- "$state"
}

existing_database_for() {
  local task="$1" state database
  state="$(database_state_for "$task")"
  if [[ -f "$state" ]]; then
    database="$(<"$state")"
    case "$database" in
      sqlite|postgres) printf '%s' "$database"; return ;;
      *) die "invalid stored agent database mode: $database" ;;
    esac
  fi
  printf '%s' "$AGENT_DATABASE"
}

delete_database_state() {
  local task="$1" state
  state="$(database_state_for "$task")"
  [[ ! -L "$state" ]] || die "refusing to delete symlinked database state: $state"
  rm -f -- "$state"
}

backend_port_for() {
  local task="$1" digest offset
  digest="$(printf '%s' "$task" | shasum | cut -c1-8)"
  offset=$((16#$digest % 900))
  printf '%s' "$((3100 + offset))"
}

router_ready() { command -v caddy >/dev/null 2>&1; }

render_routes() {
  local route task port
  mkdir -p "$AGENT_STATE_ROOT/routes"
  {
    echo '{'
    echo '  auto_https disable_redirects'
    echo '}'
    echo
    for route in "$AGENT_STATE_ROOT"/routes/*; do
      [[ -f "$route" ]] || continue
      task="$(basename "$route")"; port="$(<"$route")"
      cat <<EOF
https://${task}.localhost {
  bind 127.0.0.1
  tls internal
  reverse_proxy 127.0.0.1:${port}
}

EOF
    done
  } >"$CADDYFILE"
}

reload_router() {
  router_ready || return 1
  render_routes
  caddy reload --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1
}

setup() {
  if ! router_ready; then
    cat >&2 <<EOF
Caddy is required for worktree browser URLs.
Install it with:

  brew install caddy

Then run this command again. Caddy's local CA must also be trusted once:

  sudo caddy trust
EOF
    return 1
  fi
  mkdir -p "$AGENT_STATE_ROOT/routes"
  render_routes
  caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null || \
    die "invalid Caddy configuration: $CADDYFILE"
  local plist="$(mktemp -t elef-agent-router).plist"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.elef.agent-router</string>
  <key>ProgramArguments</key><array>
    <string>$(command -v caddy)</string><string>run</string>
    <string>--config</string><string>$CADDYFILE</string>
    <string>--adapter</string><string>caddyfile</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$AGENT_STATE_ROOT</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>$AGENT_STATE_ROOT</string>
    <key>XDG_CONFIG_HOME</key><string>$AGENT_STATE_ROOT/caddy-config</string>
    <key>XDG_DATA_HOME</key><string>$AGENT_STATE_ROOT/caddy-data</string>
  </dict>
  <key>StandardOutPath</key><string>$AGENT_STATE_ROOT/caddy.log</string>
  <key>StandardErrorPath</key><string>$AGENT_STATE_ROOT/caddy-error.log</string>
</dict></plist>
EOF
  sudo install -m 644 "$plist" /Library/LaunchDaemons/com.elef.agent-router.plist
  rm -f "$plist"
  sudo launchctl bootout system/com.elef.agent-router 2>/dev/null || true
  sudo launchctl bootstrap system /Library/LaunchDaemons/com.elef.agent-router.plist
  sudo launchctl kickstart -k system/com.elef.agent-router
  sudo install -d -m 755 "$AGENT_STATE_ROOT/caddy-config" "$AGENT_STATE_ROOT/caddy-data"
  sudo caddy trust --address 127.0.0.1:2019
  echo "Caddy is running on local HTTPS port 443."
  echo "Run '$0 start TASK' to create https://TASK.localhost."
}

build_image() {
  need_container
  local image="${1:-$(image_for)}"
  "$CONTAINER_CLI" build --tag "$image" \
    --build-arg "DEV_UID=$(id -u)" --build-arg "DEV_GID=$(id -g)" \
    --build-arg "CODEX_VERSION=$CODEX_VERSION" \
    --build-arg "CHROME_DEVTOOLS_MCP_VERSION=$CHROME_DEVTOOLS_MCP_VERSION" \
    --file "$REPO/.devcontainer/Containerfile" "$REPO"
}

image_exists() {
  "$CONTAINER_CLI" image inspect "$1" >/dev/null 2>&1
}

ensure_image() {
  local image="${1:-$(image_for)}"
  if image_exists "$image"; then
    echo "Reusing image $image"
  else
    echo "Building image $image"
    build_image "$image"
  fi
}

token_for_gh() {
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then printf '%s' "$GITHUB_TOKEN"
  elif [[ -n "${GH_TOKEN:-}" ]]; then printf '%s' "$GH_TOKEN"
  elif command -v gh >/dev/null 2>&1; then gh auth token 2>/dev/null || true
  fi
}

load_dotenv() {
  local env_file
  for env_file in "$REPO/.env" "$REPO/.env.local"; do
    if [[ -f "$env_file" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$env_file"
      set +a
    fi
  done
}

container_exists() {
  "$CONTAINER_CLI" inspect "$1" >/dev/null 2>&1
}

container_running() {
  "$CONTAINER_CLI" inspect "$1" 2>/dev/null | grep -Eq '"state"[[:space:]]*:[[:space:]]*"running"|"status"[[:space:]]*:[[:space:]]*"running"|"running"[[:space:]]*:[[:space:]]*true'
}

route_up() {
  local task="$1" port="$2" route
  route="$(route_for "$(host_for "$task")")"
  printf '%s' "$port" >"$route"
  if ! reload_router; then
    rm -f "$route"
    reload_router || true
    return 1
  fi
}

startup_log_path() {
  local task="$1" directory
  directory="$AGENT_STATE_ROOT/logs"
  mkdir -p "$directory"
  (umask 077; mktemp "$directory/${task}.startup.XXXXXX")
}

start_startup_log_capture() {
  local name="$1" log_file="$2"
  STARTUP_LOG_LINE_COUNT=0
  "$CONTAINER_CLI" logs --follow "$name" >>"$log_file" 2>&1 &
  STARTUP_LOG_PID=$!
}

stop_startup_log_capture() {
  [[ -n "$STARTUP_LOG_PID" ]] || return 0
  kill "$STARTUP_LOG_PID" >/dev/null 2>&1 || true
  wait "$STARTUP_LOG_PID" 2>/dev/null || true
  STARTUP_LOG_PID=""
}

emit_startup_log_updates() {
  local log_file="$1" line_count
  [[ -f "$log_file" ]] || return 0
  line_count="$(wc -l <"$log_file" | tr -d '[:space:]')"
  [[ "$line_count" =~ ^[0-9]+$ ]] || line_count=0
  (( line_count > STARTUP_LOG_LINE_COUNT )) || return 0
  tail -n "+$((STARTUP_LOG_LINE_COUNT + 1))" "$log_file"
  STARTUP_LOG_LINE_COUNT="$line_count"
}

wait_for_http() {
  local task="$1" port="$2" name="$3" log_file="$4" attempt=0 backend_code route_code deadline
  STARTUP_BACKEND_CODE=000
  STARTUP_ROUTE_CODE=000
  STARTUP_HTTP_CODE=000
  STARTUP_FAILURE_REASON=""
  deadline=$((SECONDS + STARTUP_TIMEOUT))
  while (( attempt == 0 || SECONDS < deadline )); do
    ((attempt += 1))
    backend_code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 1 --max-time 2 "http://127.0.0.1:$port/" 2>/dev/null || true)"
    route_code=000
    if [[ "$backend_code" =~ ^[1-5][0-9][0-9]$ ]]; then
      route_code="$(curl -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 1 --max-time 2 "https://$(host_for "$task").localhost" 2>/dev/null || true)"
      if [[ "$route_code" =~ ^[1-5][0-9][0-9]$ && "$route_code" != 502 && "$route_code" != 503 && "$route_code" != 504 ]]; then
        STARTUP_BACKEND_CODE="$backend_code"
        STARTUP_ROUTE_CODE="$route_code"
        STARTUP_HTTP_CODE="$route_code"
        emit_startup_log_updates "$log_file"
        return 0
      fi
    fi
    STARTUP_BACKEND_CODE="$backend_code"
    STARTUP_ROUTE_CODE="$route_code"
    emit_startup_log_updates "$log_file"
    if (( attempt >= 10 )) && ! container_running "$name"; then
      STARTUP_FAILURE_REASON="the task container stopped before Rails became reachable"
      return 1
    fi
    (( SECONDS < deadline )) || break
    sleep 1
  done
  STARTUP_FAILURE_REASON="timed out after ${STARTUP_TIMEOUT}s waiting for the backend and HTTPS route"
  return 1
}

report_readiness() {
  local task="$1" code="$2"
  if [[ "$code" -ge 500 ]]; then
    echo "Rails reachable at https://$(host_for "$task").localhost (HTTP $code); application is unhealthy" >&2
  else
    echo "Rails ready at https://$(host_for "$task").localhost (HTTP $code)"
  fi
}

append_startup_diagnostics() {
  local task="$1" name="$2" log_file="$3" container_state
  if container_running "$name"; then container_state=running; else container_state=stopped_or_unavailable; fi
  {
    printf '\n--- Elef startup failure summary ---\n'
    printf 'task: %s\ncontainer: %s\ncontainer_state: %s\n' "$task" "$name" "$container_state"
    printf 'failure: %s\n' "$STARTUP_FAILURE_REASON"
    printf 'last_backend_http_status: %s\nlast_https_route_http_status: %s\n' "$STARTUP_BACKEND_CODE" "$STARTUP_ROUTE_CODE"
    printf 'url: https://%s.localhost\n' "$(host_for "$task")"
    printf '\n--- Apple Container CLI version ---\n'
    "$CONTAINER_CLI" --version 2>&1 || true
    printf '\n--- Container stdout/stderr snapshot ---\n'
    "$CONTAINER_CLI" logs "$name" 2>&1 || true
    printf '\n--- Container boot log snapshot ---\n'
    "$CONTAINER_CLI" logs --boot "$name" 2>&1 || true
    printf '\n--- Recent Apple Container service logs ---\n'
    "$CONTAINER_CLI" system logs --last 5m 2>&1 || true
  } >>"$log_file"
}

fail_task_startup() {
  local task="$1" name="$2" log_file="$3" route
  stop_startup_log_capture
  if container_exists "$name"; then
    "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
  fi
  route="$(route_for "$(host_for "$task")")"
  rm -f "$route"
  reload_router || true
  append_startup_diagnostics "$task" "$name" "$log_file"
  emit_startup_log_updates "$log_file" >&2
  printf 'error: startup failed for %s: %s\n' "$task" "$STARTUP_FAILURE_REASON" >&2
  printf 'Last backend HTTP status: %s; HTTPS route HTTP status: %s\n' "$STARTUP_BACKEND_CODE" "$STARTUP_ROUTE_CODE" >&2
  printf 'Full startup diagnostics: %s\n' "$log_file" >&2
  if container_exists "$name"; then
    printf 'The stopped container was retained for inspection: %s\n' "$name" >&2
    printf 'Inspect its logs with: %s logs %s\n' "$CONTAINER_CLI" "$name" >&2
    printf 'After reviewing the log, retry this existing task with: %s up %s\n' "$0" "$task" >&2
  else
    printf 'The container no longer exists; the startup log above is preserved.\n' >&2
  fi
  printf '\nMost recent startup diagnostics:\n' >&2
  tail -n 80 "$log_file" >&2
  exit 1
}

await_task_readiness() {
  local task="$1" name="$2" backend_port="$3" log_file
  log_file="$(startup_log_path "$task")"
  {
    printf 'task: %s\ncontainer: %s\n' "$task" "$name"
    printf 'started_at_utc: %s\nreadiness_timeout_seconds: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$STARTUP_TIMEOUT"
    printf '\n--- Live container startup output ---\n'
  } >"$log_file"
  STARTUP_LOG_LINE_COUNT="$(wc -l <"$log_file" | tr -d '[:space:]')"
  start_startup_log_capture "$name" "$log_file"
  trap 'stop_startup_log_capture' EXIT
  echo "Waiting up to ${STARTUP_TIMEOUT}s for Rails; startup output is streamed and saved to $log_file"
  if ! route_up "$task" "$backend_port"; then
    STARTUP_FAILURE_REASON="unable to register the local HTTPS route"
    fail_task_startup "$task" "$name" "$log_file"
  fi
  if wait_for_http "$task" "$backend_port" "$name" "$log_file"; then
    stop_startup_log_capture
    emit_startup_log_updates "$log_file"
    trap - EXIT
    echo "Startup log: $log_file"
    report_readiness "$task" "$STARTUP_HTTP_CODE"
  else
    fail_task_startup "$task" "$name" "$log_file"
  fi
}

ensure_base_current() {
  local base="$1" remote_ref
  [[ "$base" =~ ^[A-Za-z0-9._/-]+$ ]] || return 0
  git show-ref --verify --quiet "refs/heads/$base" || return 0
  remote_ref="refs/remotes/origin/$base"
  git fetch origin "refs/heads/$base:$remote_ref" || \
    die "unable to refresh origin/$base before continuing"
  git merge-base --is-ancestor "$remote_ref" "refs/heads/$base" || \
    die "local $base is behind or diverged from origin/$base; sync it before continuing"
}

run_container() {
  local task="$1" wt="$2" name="$3" token="$4" backend_port="$5" image="$6" codex_state sqlite_env
  validate_agent_database
  sqlite_env=
  [[ "$AGENT_DATABASE" == sqlite ]] && sqlite_env=1
  codex_state="$(codex_state_for "$task")"
  mkdir -p "$codex_state"
  local -a mounts=(
    --volume "$wt:$wt"
    --volume "$REPO/.git:$REPO/.git"
    --volume "$codex_state:/home/developer/.codex"
  )
  if [[ -d "$USER_SKILLS_HOST" ]]; then
    echo "Mounting Codex skills from $USER_SKILLS_HOST"
    mounts+=(--volume "$USER_SKILLS_HOST:/home/developer/.codex/skills:ro")
  else
    echo "warning: user skills directory not found: $USER_SKILLS_HOST" >&2
  fi
  [[ -f "$HOME/.gitconfig" ]] && mounts+=(--volume "$HOME/.gitconfig:/home/developer/.gitconfig:ro")
  [[ -f "$CODEX_HOME_HOST/auth.json" ]] && mounts+=(--volume "$CODEX_HOME_HOST/auth.json:/home/developer/.codex/auth.json:ro")
  [[ -f "$GH_CONFIG_HOST/hosts.yml" ]] && mounts+=(--volume "$GH_CONFIG_HOST/hosts.yml:/home/developer/.config/gh/hosts.yml:ro")
  "$CONTAINER_CLI" run --name "$name" --detach --init \
    --memory "$CONTAINER_MEMORY" \
    --publish "127.0.0.1:${backend_port}:3000" \
    --env "GITHUB_TOKEN=$token" --env "GH_TOKEN=$token" \
    --env GIT_CONFIG_GLOBAL=/home/developer/.config/git/config \
    --env "ELEF_USE_SQLITE=$sqlite_env" \
    --env PORT=3000 --env BIND=0.0.0.0 \
    "${mounts[@]}" --workdir "$wt" "$image" web
}

start_task() {
  local task="$1" wt="$2" name="$3" token="$4" backend_port="$5" image="$6"
  run_container "$task" "$wt" "$name" "$token" "$backend_port" "$image"
  await_task_readiness "$task" "$name" "$backend_port"
}

start() {
  local task="${1:-}" base="${2:-HEAD}" current_base wt name branch token backend_port host image
  [[ -n "$task" ]] || die "usage: elef-agent start TASK [BASE]"
  validate_agent_database
  validate_startup_timeout
  safe_name "$task"
  assert_task_branch_available "$task"
  if [[ "$base" == "HEAD" ]]; then
    current_base="$(git branch --show-current)"
    [[ -z "$current_base" ]] || ensure_base_current "$current_base"
  else
    ensure_base_current "$base"
  fi
  host="$(host_for "$task")"
  router_ready || die "Caddy is not installed; run '$0 setup' first"
  [[ ! "$host" =~ (^|\.)([.-]|$) ]] || die "task name cannot contain empty or hyphen-starting hostname labels: $task"
  load_dotenv
  token="$(token_for_gh)"
  [[ -n "$token" ]] || die "GitHub token unavailable; run 'gh auth login' or set GITHUB_TOKEN"
  wt="$(worktree_for "$task")"; name="$(container_for "$task")"; branch="$(branch_for "$task")"
  backend_port="$(backend_port_for "$task")"
  [[ ! -e "$wt" ]] || die "worktree already exists: $wt"
  need_container
  if ! container_exists "$name" && lsof -nP -iTCP:"$backend_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "backend port is already in use: $backend_port"
  fi
  [[ ! -e "$(route_for "$host")" ]] || die "browser route already exists: https://${host}.localhost"
  "$CONTAINER_CLI" system start >/dev/null
  mkdir -p "$WORKTREE_ROOT"
  git worktree add -b "$branch" "$wt" "$base"
  image="$(new_image_for)"
  if ! ensure_image "$image"; then
    git worktree remove --force "$wt"
    git branch -D "$branch" >/dev/null 2>&1 || true
    die "unable to build image $image"
  fi
  remember_image "$task" "$image"
  remember_database "$task"
  start_task "$task" "$wt" "$name" "$token" "$backend_port" "$image"
  echo "Started $name"
  echo "Worktree: $wt"
  echo "Branch:   $branch"
  echo "Database: $AGENT_DATABASE"
  echo "Browser:  https://${host}.localhost"
  exec_in "$task" codex --dangerously-bypass-approvals-and-sandbox -m "$CODEX_MODEL" -c 'model_reasoning_effort="max"' -c 'plan_mode_reasoning_effort="max"'
}

up() {
  local task="${1:-}" wt name token backend_port host image
  [[ -n "$task" ]] || die "usage: elef-agent up TASK"
  safe_name "$task"
  validate_startup_timeout
  [[ -n "${ELEF_AGENT_DATABASE:-}" ]] || AGENT_DATABASE="$(existing_database_for "$task")"
  validate_agent_database
  wt="$(require_worktree "$task")"; name="$(container_for "$task")"; host="$(host_for "$task")"
  assert_no_active_terminal "$task"
  router_ready || die "Caddy is not installed; run '$0 setup' first"
  load_dotenv
  token="$(token_for_gh)"; [[ -n "$token" ]] || die "GitHub token unavailable"
  backend_port="$(backend_port_for "$task")"
  if ! container_running "$name" && lsof -nP -iTCP:"$backend_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "backend port is already in use: $backend_port"
  fi
  "$CONTAINER_CLI" system start >/dev/null
  image="$(existing_image_for "$task")"
  ensure_image "$image"
  remember_image "$task" "$image"
  remember_database "$task"
  if container_exists "$name"; then
    # Recreate the disposable container so tasks created by older launcher
    # versions receive the managed web-process command as well.
    "$CONTAINER_CLI" stop "$name" >/dev/null 2>&1 || true
    "$CONTAINER_CLI" delete "$name" >/dev/null 2>&1 || true
  fi
  run_container "$task" "$wt" "$name" "$token" "$backend_port" "$image"
  await_task_readiness "$task" "$name" "$backend_port"
}

restore_terminal() {
  [[ -t 1 ]] || return 0
  printf '\033[<u\033[?2004l\033[?1l\033[?1004l' || true
  stty sane 2>/dev/null || true
}

clear_terminal_state() {
  local task="$1" state
  state="$(terminal_state_for "$task")"
  rm -f -- "$state"
}

restore_task_terminal() {
  local task="$1" state terminal
  state="$(terminal_state_for "$task")"
  [[ -f "$state" ]] || return 0
  terminal="$(<"$state")"
  [[ "$terminal" == /dev/tty* ]] || { clear_terminal_state "$task"; return 0; }
  printf '\033[<u\033[?2004l\033[?1l\033[?1004l' >"$terminal" 2>/dev/null || true
  stty sane <"$terminal" 2>/dev/null || true
  clear_terminal_state "$task"
}

assert_no_active_terminal() {
  local task="$1" state
  state="$(terminal_state_for "$task")"
  [[ ! -s "$state" ]] || die "task has an active Codex terminal; exit Codex before cleanup"
}

exec_in() {
  local task="$1" status terminal state wt; shift
  safe_name "$task"; wt="$(require_worktree "$task")"; need_container
  terminal="$(tty 2>/dev/null || true)"
  if [[ "$terminal" == /dev/tty* ]]; then
    state="$(terminal_state_for "$task")"
    mkdir -p "$(dirname "$state")"
    printf '%s\n' "$terminal" >"$state"
  fi
  trap 'restore_terminal; clear_terminal_state "$task"' EXIT
  "$CONTAINER_CLI" exec --interactive --tty --workdir "$wt" "$(container_for "$task")" "$@"
  status=$?
  trap - EXIT
  restore_terminal
  clear_terminal_state "$task"
  return "$status"
}

status() {
  local route host port state code
  printf '%-32s %-10s %-8s %s\n' "TASK" "CONTAINER" "HTTP" "URL"
  for route in "$AGENT_STATE_ROOT"/routes/*; do
    [[ -f "$route" ]] || continue
    host="$(basename "$route")"; port="$(<"$route")"; state="stopped"; code="down"
    container_exists "$(container_for "$host")" && state="present"
    container_running "$(container_for "$host")" && state="running"
    code="$(curl -k -sS -o /dev/null -w '%{http_code}' --max-time 2 "https://${host}.localhost" 2>/dev/null || true)"
    [[ "$code" =~ ^[1-5][0-9][0-9]$ ]] || code="down"
    printf '%-32s %-10s %-8s https://%s.localhost\n' "$host" "$state" "$code" "$host"
  done
}

stop() {
  local task="${1:-}" host; [[ -n "$task" ]] || die "usage: elef-agent stop TASK"
  safe_name "$task"; host="$(host_for "$task")"; need_container
  assert_no_active_terminal "$task"
  restore_task_terminal "$task"
  "$CONTAINER_CLI" stop "$(container_for "$task")" || echo "warning: container may already be stopped" >&2
  rm -f "$(route_for "$host")"
  reload_router || die "Caddy is not running; route removed but its configuration could not be reloaded"
}

remove() {
  local task="${1:-}" wt name host
  [[ -n "$task" ]] || die "usage: elef-agent remove TASK"
  safe_name "$task"; host="$(host_for "$task")"; wt="$(worktree_for "$task")"
  if [[ -e "$wt" ]]; then wt="$(require_worktree "$task")"; fi
  name="$(container_for "$task")"; need_container
  "$CONTAINER_CLI" stop "$name" 2>/dev/null || true
  "$CONTAINER_CLI" delete "$name" 2>/dev/null || true
  rm -f "$(route_for "$host")"
  router_ready && reload_router || true
  [[ ! -e "$wt" ]] || git worktree remove --force "$wt"
  git branch -D "$(branch_for "$task")" 2>/dev/null || true
  delete_database_state "$task"
  echo "Removed container, worktree, and local branch for $task"
}

pr_number_for_branch() {
  local repo="$1" branch="$2"
  gh pr list --repo "$repo" --head "$branch" --state all --json number,state \
    --jq 'map(select(.state == "MERGED")) | .[0].number // empty'
}

verify_merged_pr() {
  local repo="$1" pr_number="$2" pr_state base merge_commit target_ref
  pr_state="$(gh pr view "$pr_number" --repo "$repo" --json state --jq .state)"
  [[ "$pr_state" == "MERGED" ]] || die "refusing cleanup: PR #$pr_number is not merged"

  base="$(gh pr view "$pr_number" --repo "$repo" --json baseRefName --jq .baseRefName)"
  [[ "$base" =~ ^[A-Za-z0-9._/-]+$ ]] || die "refusing cleanup: invalid PR target branch: $base"
  merge_commit="$(gh pr view "$pr_number" --repo "$repo" --json mergeCommit --jq '.mergeCommit.oid // empty')"
  [[ -n "$merge_commit" ]] || die "refusing cleanup: PR #$pr_number has no merge commit"

  target_ref="refs/remotes/origin/$base"
  git fetch origin "refs/heads/$base:$target_ref" || \
    die "refusing cleanup: unable to refresh origin/$base"
  git merge-base --is-ancestor "$merge_commit" "$target_ref" || \
    die "refusing cleanup: merge commit $merge_commit is not reachable from origin/$base"
  echo "Verified PR #$pr_number merge $merge_commit on origin/$base"
}

pr_body_for() {
  local task="$1" base="$2" branch="$3" commits changed_files database_paths database_note
  commits="$(git log --no-merges --format='- %s' "$base..$branch" 2>/dev/null || true)"
  [[ -n "$commits" ]] || commits="- Complete isolated task: $task"
  changed_files="$(git diff --name-only "$base...$branch" 2>/dev/null || true)"
  database_paths="$(printf '%s\n' "$changed_files" | grep -E '^(db/|config/database\.yml$|Gemfile$|Gemfile\.lock$|app/models/|app/services/)' || true)"
  if [[ -n "$database_paths" ]]; then
    database_note="- Database-related paths changed: $(printf '%s' "$database_paths" | tr '\n' ' ')"
  else
    database_note="- No database, migration, model, or persistence-service paths changed."
  fi

  cat <<EOF
## Summary
$commits

## Why
- This PR completes the isolated Elef task \`$task\`; the commit summary above records its scope.

## Database / migration impact
$database_note
- Add deployment or data-migration notes here when they apply.

## Validation
- GitHub Actions will run the repository checks before merge.
- Record focused local tests and browser checks here before requesting review.

## Follow-up
- None recorded by the task launcher.
EOF
}

validate_pr_description() {
  local repo="$1" pr_number="$2" body
  body="$(gh pr view "$pr_number" --repo "$repo" --json body --jq '.body // ""')"
  PR_BODY="$body" ruby "$REPO/scripts/check_pr_description.rb"
}

cleanup() {
  local task="${1:-}" wt name branch repo pr_number host
  [[ -n "$task" ]] || die "usage: elef-agent cleanup TASK"
  safe_name "$task"; host="$(host_for "$task")"; wt="$(require_worktree "$task")"; name="$(container_for "$task")"; branch="$(branch_for "$task")"
  [[ -e "$wt" ]] || die "worktree not found: $wt"
  [[ -z "$(git -C "$wt" status --porcelain)" ]] || die "worktree has uncommitted changes: $wt"
  command -v gh >/dev/null || die "GitHub CLI not found"
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" || die "unable to determine GitHub repository"
  pr_number="$(pr_number_for_branch "$repo" "$branch")"
  [[ -n "$pr_number" ]] || die "refusing cleanup: no merged PR found for $branch"
  verify_merged_pr "$repo" "$pr_number"
  need_container
  assert_no_active_terminal "$task"
  restore_task_terminal "$task"
  "$CONTAINER_CLI" stop "$name" 2>/dev/null || true
  "$CONTAINER_CLI" delete "$name" 2>/dev/null || true
  rm -f "$(route_for "$host")"
  router_ready && reload_router || true
  git worktree remove "$wt"
  git branch -D "$branch"
  git push origin --delete "$branch"
  delete_codex_state "$task"
  delete_image_state "$task"
  delete_database_state "$task"
  echo "Cleaned up merged task $task"
}

finish() {
  local task="${1:-}" title base branch repo pr_number pr_state body
  [[ -n "$task" ]] || die "usage: elef-agent finish TASK [TITLE]"
  safe_name "$task"
  local wt
  wt="$(require_worktree "$task")"
  [[ -z "$(git -C "$wt" status --porcelain)" ]] || \
    die "worktree has uncommitted changes: $wt"
  command -v gh >/dev/null || die "GitHub CLI not found"
  title="${2:-Ship $task}"
  base="$(git branch --show-current)"
  [[ -n "$base" ]] || die "current checkout is not on a branch"
  ensure_base_current "$base"
  branch="$(branch_for "$task")"
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" || \
    die "unable to determine GitHub repository"
  pr_number="$(gh pr list --repo "$repo" --head "$branch" --state all --json number --jq '.[0].number // empty')"
  if [[ -z "$pr_number" ]]; then
    body="$(pr_body_for "$task" "$base" "$branch")"
    gh pr create --repo "$repo" --base "$base" --head "$branch" \
      --title "$title" --body "$body"
    pr_number="$(gh pr list --repo "$repo" --head "$branch" --state all --json number --jq '.[0].number // empty')"
  fi
  [[ -n "$pr_number" ]] || die "unable to determine pull request for $branch"
  validate_pr_description "$repo" "$pr_number"
  gh pr checks "$pr_number" --repo "$repo" --watch --fail-fast
  gh pr merge "$pr_number" --repo "$repo" --merge --subject "$title"
  for _ in {1..30}; do
    pr_state="$(gh pr view "$pr_number" --repo "$repo" --json state --jq .state)"
    [[ "$pr_state" == "MERGED" ]] && break
    sleep 1
  done
  [[ "$pr_state" == "MERGED" ]] || die "pull request $pr_number was not confirmed merged"
  cleanup "$task"
}

help() {
  cat <<EOF
Elef disposable agent workflow

Use this command to create and operate an isolated Elef development task. Each
task gets a sibling Git worktree, an Apple Container, and a stable browser URL:

  https://TASK.localhost

Recommended lifecycle:

  1.  $0 setup
  2.  $0 start TASK [BASE]
  3.  $0 status
  4.  Review and merge the task PR into the target branch on GitHub
  5.  Confirm the PR is merged
  6.  $0 cleanup TASK

Commands:

  setup                 Install/configure the local Caddy HTTPS router.
                        Run once before starting isolated browser-accessible
                        tasks. Requires Caddy and sudo.

  start TASK [BASE]     Create a new task worktree and branch, build/reuse the
                        agent image, start its container and Rails, then launch
                        Codex immediately. Use for a brand-new isolated task.
                        BASE defaults to HEAD; it may be a branch, tag, or
                        commit. Pass 'dev' explicitly to pin a task to dev.

  codex TASK [PROMPT...] Launch Codex inside a running task container.
                        Use for the first implementation prompt or a follow-up
                        prompt. The task must already exist and be running.

  fork TASK [PROMPT...] Fork the most recent Codex session inside a running
                        task container.

  resume TASK           Resume the last Codex session inside the task.
                        Use when Codex exited and you want to continue its
                        conversation rather than start a new prompt.

  shell TASK [COMMAND...] Open a shell or run a command in the task container.
                        Use for tests, Rails commands, logs, or diagnosis.
                        Example: $0 shell TASK bin/rails test test/models

  status                Show known tasks, container state, HTTP readiness, and
                        browser URLs. Use to find a task's current state.

  stop TASK             Stop the task container and unregister its browser
                        route, while preserving its worktree and branch.
                        Use when pausing work; resume later with 'up'.

  up TASK               Recreate the task container from its existing worktree
                        and restart Rails. Use after 'stop' or when a task's
                        disposable container is gone but its worktree remains.

  cleanup TASK          Remove a clean task after its PR has been merged.
                        Also deletes the local and remote task branch. This is
                        the normal end of a successfully merged task.
  finish TASK [TITLE]   Create or find the task PR, wait for CI, merge it, and
                        clean up the task after the merge is confirmed.

  remove TASK           Force-remove the task container, worktree, route, and
                        local branch without requiring a merged PR. Use only
                        for an abandoned task. It does not delete a remote
                        branch.

  build                 Build the agent container image without starting a
                        task. Use to prebuild or refresh the image.

Environment overrides:

  CONTAINER_CLI                 Container command (default: container)
  ELEF_AGENT_IMAGE              Use a specific prebuilt image
  ELEF_WORKTREE_ROOT            Worktree parent (default: ../elef-worktrees)
  ELEF_AGENT_STATE_ROOT         Router state directory
  ELEF_AGENT_CADDYFILE          Caddyfile path
  ELEF_USER_SKILLS_DIR          Host skills directory (default: ~/Development/GitHub/
                                andy-skills/skills when present, else
                                CODEX_HOME/skills when set, else ~/.codex/skills)
  ELEF_AGENT_CODEX_VERSION      Codex version used in the image
  ELEF_AGENT_CHROME_DEVTOOLS_MCP_VERSION
                                Chrome DevTools MCP version used in the image
  ELEF_AGENT_DATABASE            Agent database: sqlite (default) or postgres
  ELEF_AGENT_STARTUP_TIMEOUT     Seconds to wait for Rails (default: 300)

For command syntax, run '$0 --help'. Run commands from the Elef repository root.
EOF
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-}" in
    -h|--help|help) shift; help "$@" ;;
    setup) shift; setup "$@" ;;
    status) shift; status "$@" ;;
    start) shift; start "$@" ;;
    up) shift; up "$@" ;;
    shell) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent shell TASK [COMMAND...]"; task="$1"; shift; exec_in "$task" bash "$@" ;;
    codex) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent codex TASK [PROMPT...]"; task="$1"; shift; exec_in "$task" codex --dangerously-bypass-approvals-and-sandbox -m "$CODEX_MODEL" -c 'model_reasoning_effort="max"' -c 'plan_mode_reasoning_effort="max"' "$@" ;;
    fork) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent fork TASK [PROMPT...]"; task="$1"; shift; exec_in "$task" codex --dangerously-bypass-approvals-and-sandbox -m "$CODEX_MODEL" -c 'model_reasoning_effort="max"' -c 'plan_mode_reasoning_effort="max"' fork --last "$@" ;;
    resume) shift; [[ -n "${1:-}" ]] || die "usage: elef-agent resume TASK"; task="$1"; shift; exec_in "$task" codex --dangerously-bypass-approvals-and-sandbox -m "$CODEX_MODEL" -c 'model_reasoning_effort="max"' -c 'plan_mode_reasoning_effort="max"' resume --last "$@" ;;
    stop) shift; stop "$@" ;;
    cleanup) shift; cleanup "$@" ;;
    finish) shift; finish "$@" ;;
    remove) shift; remove "$@" ;;
    build) validate_agent_database; ensure_image "$(new_image_for)" ;;
    *) echo "usage: $0 {setup|status|start|up|codex|fork|resume|shell|stop|cleanup|finish|remove|build} TASK [ARGS...]" >&2; exit 2 ;;
  esac
fi
