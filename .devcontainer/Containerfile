FROM ruby:3.4-bookworm

ARG DEV_UID=1000
ARG DEV_GID=1000

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3 \
    CODEX_HOME=/home/developer/.codex

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
       build-essential ca-certificates chromium curl git libsqlite3-dev npm sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && curl --fail --silent --show-error https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install --no-install-recommends -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && curl --fail --silent --show-error https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && printf 'deb [arch=%s signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' "$(dpkg --print-architecture)" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y gh \
    && rm -rf /var/lib/apt/lists/* \
    && gem install bundler -v 4.0.6 \
    && npm install --global @openai/codex chrome-devtools-mcp \
    && if getent group "${DEV_GID}" >/dev/null; then DEV_GROUP="$(getent group "${DEV_GID}" | cut -d: -f1)"; else groupadd --gid "${DEV_GID}" developer; DEV_GROUP=developer; fi \
    && useradd --uid "${DEV_UID}" --gid "${DEV_GID}" --create-home --shell /bin/bash developer \
    && mkdir --parents /workspace /home/developer/.codex /home/developer/.config/gh \
    && chown --recursive "developer:${DEV_GROUP}" /workspace /home/developer

COPY .devcontainer/codex-config.toml /etc/elef/codex-config.toml
COPY .devcontainer/entrypoint.sh /usr/local/bin/elef-entrypoint
RUN chmod 0755 /usr/local/bin/elef-entrypoint

USER developer
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/elef-entrypoint"]
CMD ["sleep", "infinity"]
