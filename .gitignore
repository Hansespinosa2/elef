# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/apps/web/.bundle

# Ignore all environment files.
# Live secrets live at the repo root (.env.personal / .env.development, see
# ops/*-instance); the tracked examples live at ops/.env.*.example.
/.env*

# Personal instance backup bundles can contain the complete database and files.
/backups/

# Ignore old/local JavaScript dependency installs (root and nested: npm
# workspaces nest a package's node_modules when hoisting would break a
# version constraint, e.g. packages/editor-runtime).
node_modules/
/target
/apps/desktop/target
/apps/desktop/frontend/dist
/apps/desktop/frontend/dist-e2e
/apps/desktop/frontend/dist-dev
/apps/desktop/frontend/dist-e2e-stable
/packages/contracts/dist
# Package build metafiles are regenerable proof inputs for the Stable/Dev
# profile checker (run the package builds first); the dist bundles stay tracked.
packages/*/dist/*.metafile.json
/apps/desktop/src-tauri/gen/schemas
/apps/desktop/src-tauri/permissions/autogenerated
# Release builds merge this generated updater config over tauri.conf.json; it
# carries the release version and lane and is regenerated every release.
/apps/desktop/src-tauri/tauri.release.generated.conf.json
# The Arch package gate generates the Linux release config per version; it is
# regenerated every run.
/apps/desktop/src-tauri/tauri.linux-release.generated.conf.json

# Ignore all logfiles and tempfiles.
/apps/web/log/*
/apps/web/tmp/*
!/apps/web/log/.keep
!/apps/web/tmp/.keep

# Ignore pidfiles, but keep the directory.
/apps/web/tmp/pids/*
!/apps/web/tmp/pids/
!/apps/web/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/apps/web/storage/*
!/apps/web/storage/.keep
/apps/web/tmp/storage/*
!/apps/web/tmp/storage/
!/apps/web/tmp/storage/.keep

/apps/web/public/assets

# Ignore key files for decrypting credentials and more.
/apps/web/config/*.key

/docs/notes/*
/apps/web/app/assets/builds/*
!/apps/web/app/assets/builds/.keep
!/apps/web/app/assets/builds/tailwind.css

# Ignore campaign scratch (disposable gate checkouts, review bundles, probes).
/tmp/

# Ignore desktop e2e run outputs (regenerable diagnostics; CI uploads them).
/apps/desktop/e2e/logs/
/apps/desktop/e2e/test-results/
/apps/desktop/e2e/playwright-report/
/apps/desktop/e2e/native-scenarios.log
