# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/apps/web/.bundle

# Ignore all environment files.
/.env*
!.env.example
!.env.personal.example
!.env.development.example

# Personal instance backup bundles can contain the complete database and files.
/backups/

# Ignore old/local JavaScript dependency installs.
/node_modules
/target
/apps/desktop/target
/apps/desktop/frontend/node_modules
/apps/desktop/e2e/node_modules
/apps/desktop/frontend/dist
/apps/desktop/frontend/dist-e2e
/packages/contracts/dist
/apps/desktop/src-tauri/gen/schemas
/apps/desktop/src-tauri/permissions/autogenerated

# Ignore all logfiles and tempfiles.
/apps/web/log/*
/apps/web/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/apps/web/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/apps/web/storage/*
!/storage/.keep
/apps/web/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/apps/web/public/assets

# Ignore key files for decrypting credentials and more.
/apps/web/config/*.key

/docs/notes/*
/apps/web/app/assets/builds/*
!/app/assets/builds/.keep
!/app/assets/builds/tailwind.css
