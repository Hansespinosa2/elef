        status = read_json(STATUS_PATH)
        head = check_phase6(status)
        run_tier(QUICK_COMMANDS_1, QUICK_CEILING_S, quiet=True)
        for command in ARCH_COMMANDS_1:
            run_step(command)
        run_fresh()
        check_remaining_stubs()
        check_phase6_ci_evidence(status, head)
        after_status = git("status", "--porcelain", "--untracked-files=all")
        if after_status != before_status:
            fail("Phase 06 verification changed the candidate working tree")
    except (CheckFailure, KeyError, TypeError, ValueError, OSError, json.JSONDecodeError) as error:
        errors.append(str(error))
    if errors:
