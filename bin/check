# Full release/integration envelope (constitution §7). Rails suites rely on
# ambient PGPASSWORD like the affected tier; the sqlite variants pin their own
# adapter. Browser/native suites serialize inside their steps; each step cleans
# its harness processes so repeated runs start cold.
ALL_COMMANDS_1 = (
    *AFFECTED_COMMANDS_1,
    ("freshness checks", run_fresh_tier),


    "ELEF_USE_SQLITE=1 apps/web/bin/rails db:test:prepare",
    "ELEF_USE_SQLITE=1 apps/web/bin/rails test",
    "apps/web/bin/rails test",
    "PARALLEL_WORKERS=1 apps/web/bin/rails test test/system",
    ("desktop e2e (debug build + native suite)", run_desktop_e2e),
    ("web e2e (seeded playwright suite)", run_web_e2e),
    ("native benchmark (release build + 20 runs)", run_native_benchmark),
)


ARCH_COMMANDS_1 = (
    "python3 apps/web/script/check_frontend_ownership.py",
    "python3 tooling/check_boundaries.py",
    "python3 tooling/check_boundaries.py --self-test",
    "python3 tooling/check_spec.py",
    f"python3 {DESKTOP_PATH_PREFIX}scripts/check_architecture.py",
)


ENV_REQUIRED_PATTERN = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*):\?([^}]*)\}")
ENV_ASSIGN_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def run_step(command: str) -> float:
    import shlex
    import time

    def require(match: "re.Match") -> str:
        name, message = match.group(1), match.group(2)
        value = os.environ.get(name, "")
        if not value:
            fail(f"required environment for step is missing: {message}")
        return value

    expanded = ENV_REQUIRED_PATTERN.sub(require, command)
    parts = shlex.split(expanded)
    env = dict(os.environ)
    while parts and ENV_ASSIGN_PATTERN.match(parts[0]):
        key, value = parts[0].split("=", 1)
        env[key] = value
        parts = parts[1:]
    if not parts:
        fail(f"step has no command: {command}")
    step_cwd = ROOT
    if parts[0].startswith("apps/web/bin/"):
        # Rails binstubs run inside apps/web (rake resolves its Rakefile from
        # the working directory); the recorded command string keeps the
        # root-relative form while argv resolves app-relative paths.
        step_cwd = ROOT / "apps" / "web"
        parts = [part[len("apps/web/"):] if part.startswith("apps/web/") else part for part in parts]
    started = time.monotonic()
    result = subprocess.run(
        parts,
        cwd=step_cwd,
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    elapsed = time.monotonic() - started
    if result.returncode:
        tail = (result.stdout + result.stderr).strip().splitlines()[-20:]
        fail(f"step failed ({result.returncode}): {command}\n" + "\n".join(tail))
    return elapsed


def run_tier(commands: tuple, ceiling: float, quiet: bool) -> dict:
    durations: dict = {}
    for entry in commands:
        if isinstance(entry, tuple):
            label, step = entry
            durations[label] = step()
            continue
        durations[entry] = run_step(entry)
    total = sum(durations.values())
    if total > ceiling:
        fail(f"tier total {total:.1f}s exceeds the {ceiling:.0f}s ceiling")
    if not quiet:
        for command, elapsed in durations.items():
            print(f"{elapsed:8.1f}s  {command}")
        print(f"{total:8.1f}s  total (ceiling {ceiling:.0f}s)")
    return durations


def check_contracts_fresh() -> None:
    import shutil
    import tempfile

    with tempfile.TemporaryDirectory(prefix="elef-contracts-a-") as first:
        with tempfile.TemporaryDirectory(prefix="elef-contracts-b-") as second:
            for out in (first, second):
                result = subprocess.run(
                    ["./node_modules/.bin/tsc", "-p", "packages/contracts/tsconfig.json",
                     "--outDir", out],
                    cwd=ROOT,
                    capture_output=True,
                    text=True,
                    check=False,
                )
                if result.returncode:
                    fail(f"contracts build failed:\n{(result.stdout + result.stderr).strip()[-2000:]}")
            compare = subprocess.run(
                ["diff", "-r", first, second],
                capture_output=True,
                text=True,
                check=False,
            )
            if compare.returncode:
                fail(f"contracts build is not deterministic:\n{compare.stdout.strip()[-2000:]}")


def check_renderer_fresh() -> None:
    run_step("npm run renderer:build")
    run_step("git diff --exit-code -- packages/renderer/dist/elef-renderer.bundle.js packages/renderer/dist/elef-renderer.js")


def run_fresh() -> None:
    check_renderer_fresh()
    check_contracts_fresh()


def run_tier_command(tier: str, commands: tuple, ceiling: float) -> int:
    before_status = git("status", "--porcelain", "--untracked-files=all")
    try:
        durations = run_tier(commands, ceiling, quiet=False)
        after_status = git("status", "--porcelain", "--untracked-files=all")
        if after_status != before_status:
            fail(f"bin/check {tier} changed the working tree")
    except (CheckFailure, OSError, ValueError) as error:
        print(f"bin/check {tier}: {error}", file=sys.stderr)
        return 1
    print(f"bin/check {tier}: PASS ({sum(durations.values()):.1f}s)")
    return 0


def print_usage() -> None:
    print("Usage: bin/check {quick|affected|all|arch|fresh}", file=sys.stderr)


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in COMMANDS:
        print_usage()
        return 2
    command = argv[0]
    if len(argv) != 1:
        print_usage()
        return 2
    if command == "quick":
        return run_tier_command("quick", QUICK_COMMANDS_1, QUICK_CEILING_S)
    if command == "affected":
        return run_tier_command("affected", AFFECTED_COMMANDS_1, AFFECTED_CEILING_S)
    if command == "all":
        return run_tier_command("all", ALL_COMMANDS_1, ALL_CEILING_S)
    if command == "arch":
        return run_tier_command("arch", ARCH_COMMANDS_1, QUICK_CEILING_S)
    if command == "fresh":
        before_status = git("status", "--porcelain", "--untracked-files=all")
        try:
            run_fresh()
            after_status = git("status", "--porcelain", "--untracked-files=all")
            if after_status != before_status:
                fail("bin/check fresh changed the working tree")
        except (CheckFailure, OSError, ValueError) as error:
            print(f"bin/check fresh: {error}", file=sys.stderr)
            return 1
        print("bin/check fresh: PASS")
        return 0
    print_usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
