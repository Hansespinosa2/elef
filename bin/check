#!/usr/bin/env python3


"""Steady-state repository check interface."""


from __future__ import annotations


import os
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CHECK = ROOT / "bin" / "check"


DESKTOP_SOURCE = "apps/desktop"
DESKTOP_PATH_PREFIX = DESKTOP_SOURCE + "/"


COMMANDS = ("quick", "affected", "all", "arch", "fresh")


class CheckFailure(Exception):
    pass


def fail(message: str) -> None:
    raise CheckFailure(message)


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(ROOT), *args],
        capture_output=True,
        text=True,
        check=False,
    )
    if check and result.returncode:
        fail(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout.strip()


D_E2E = DESKTOP_PATH_PREFIX + "e2e"

def run_rails_adapter_conformance() -> float:
    import socket
    import time

    pid_file = ROOT / "apps" / "web" / "tmp" / "pids" / "tier-server.pid"
    server = subprocess.Popen(
        ["apps/web/bin/rails", "server", "-e", "test", "-p", "3101", "-b", "127.0.0.1",
         "-P", str(pid_file)],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    started = time.monotonic()
    try:
        deadline = started + 90
        while True:
            try:
                socket.create_connection(("127.0.0.1", 3101), timeout=2).close()
                break
            except OSError:
                if time.monotonic() > deadline or server.poll() is not None:
                    fail("rails conformance server did not boot")
                time.sleep(1)
        node = subprocess.run(
            ["node", "tests/host-conformance/run-node.js", "rails"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
            env={**os.environ, "ELEF_CONFORMANCE_RAILS_URL": "http://127.0.0.1:3101"},
        )
        if node.returncode:
            tail = (node.stdout + node.stderr).strip().splitlines()[-20:]
            fail("rails adapter conformance failed\n" + "\n".join(tail))
    finally:
        server.terminate()
        try:
            server.wait(timeout=20)
        except subprocess.TimeoutExpired:
            server.kill()
    return time.monotonic() - started


def run_harness_step(label: str, inner: str) -> float:
    import time

    started = time.monotonic()
    try:
        result = subprocess.run(
            ["dbus-run-session", "--", "xvfb-run", "--auto-servernum", "bash", "-c",
             f"set -o pipefail; openbox --sm-disable >/tmp/elef-{label}-openbox.log 2>&1 & sleep 1; {inner}"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode:
            tail = (result.stdout + result.stderr).strip().splitlines()[-25:]
            fail(f"{label} failed\n" + "\n".join(tail))
    finally:
        for pattern in ("tauri-driver", "chromedriver", "openbox --sm-disable"):
            subprocess.run(["pkill", "-f", pattern], capture_output=True, check=False)
    return time.monotonic() - started


def run_build_step(label: str, args: list, extra_env: dict | None = None) -> float:
    import time

    started = time.monotonic()
    env = dict(os.environ)
    if extra_env:
        env.update(extra_env)
    result = subprocess.run(
        args, cwd=ROOT, capture_output=True, text=True, check=False, env=env
    )
    if result.returncode:
        tail = (result.stdout + result.stderr).strip().splitlines()[-25:]
        fail(f"{label} failed\n" + "\n".join(tail))
    return time.monotonic() - started


def run_desktop_e2e() -> float:
    build_elapsed = run_build_step(
        "desktop e2e debug build",
        ["npm", "run", "tauri:build", "--prefix", "apps/desktop/frontend", "--",
         "--debug", "--no-bundle", "--features", "webdriver",
         "--config", "src-tauri/tauri.e2e.conf.json"],
        # The e2e Tauri config reads frontendDist dist-e2e, which build.mjs
        # only emits under this flag.
        extra_env={"ELEF_E2E_BUILD": "1"},
    )
    harness_elapsed = run_harness_step(
        "desktop-e2e", "RAILS_ENV=test ELEF_USE_SQLITE=1 npm test --prefix apps/desktop/e2e"
    )
    return build_elapsed + harness_elapsed


def run_web_e2e() -> float:
    import time

    started = time.monotonic()
    result = subprocess.run(
        ["node", "apps/desktop/e2e/seed-web-fixtures.mjs"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
        env={**os.environ, "RAILS_ENV": "test", "ELEF_USE_SQLITE": "1"},
    )
    if result.returncode:
        tail = (result.stdout + result.stderr).strip().splitlines()[-25:]
        fail("web e2e failed\n" + "\n".join(tail))
    for pattern in ("chromedriver", "openbox --sm-disable"):
        subprocess.run(["pkill", "-f", pattern], capture_output=True, check=False)
    return time.monotonic() - started


def run_native_benchmark() -> float:
    build_elapsed = run_build_step(
        "native benchmark release build",
        ["npm", "run", "tauri:build", "--prefix", "apps/desktop/frontend", "--",
         "--features", "webdriver", "--no-bundle",
         "--config", "src-tauri/tauri.e2e.conf.json",
         "--config", "src-tauri/tauri.performance.conf.json"],
        extra_env={"ELEF_E2E_BUILD": "1"},
    )
    harness_elapsed = run_harness_step(
        "native-benchmark",
        'node apps/desktop/e2e/benchmark-native.mjs --binary "$PWD/target/release/elef-desktop" --report-runner',
    )
    return build_elapsed + harness_elapsed


def run_fresh_tier() -> float:
    import time

    started = time.monotonic()
    run_fresh()
    return time.monotonic() - started


