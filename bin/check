    return 0


def print_usage() -> None:
    print("Usage: bin/check {quick|affected|phase N|all|arch|fresh|docs|perf}", file=sys.stderr)


def run_tier_command(tier: str, commands: tuple, ceiling: float) -> int:
    before_status = git("status", "--porcelain", "--untracked-files=all")
    try:
        durations = run_tier(commands, ceiling, quiet=False)
        after_status = git("status", "--porcelain", "--untracked-files=all")
        if after_status != before_status:
            fail(f"bin/check {tier} changed the working tree")
    except (CheckFailure, OSError, ValueError) as error:
        print(f"bin/check {tier}: {error}", file=sys.stderr)
        return 1
    print(f"bin/check {tier}: PASS ({sum(durations.values()):.1f}s)")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in COMMANDS:
        print_usage()
        return 2
    command = argv[0]
    if command == "quick":
        if len(argv) != 1:
            print_usage()
            return 2
        return run_tier_command("quick", QUICK_COMMANDS_1, QUICK_CEILING_S)
    if command == "affected":
        if len(argv) != 1:
            print_usage()
            return 2
        return run_tier_command("affected", AFFECTED_COMMANDS_1, AFFECTED_CEILING_S)
    if command == "arch":
        if len(argv) != 1:
            print_usage()
            return 2
        return run_tier_command("arch", ARCH_COMMANDS_1, QUICK_CEILING_S)
    if command == "fresh":
        if len(argv) != 1:
            print_usage()
            return 2
        before_status = git("status", "--porcelain", "--untracked-files=all")
        try:
            run_fresh()
            after_status = git("status", "--porcelain", "--untracked-files=all")
            if after_status != before_status:
                fail("bin/check fresh changed the working tree")
        except (CheckFailure, OSError, ValueError) as error:
            print(f"bin/check fresh: {error}", file=sys.stderr)
            return 1
        print("bin/check fresh: PASS")
        return 0
    if command != "phase":
        print(f"bin/check {command} is not implemented in Phase 01.", file=sys.stderr)
        return 2
    if len(argv) < 2:
        print_usage()
        return 2
    extra = argv[2:]
    if any(item != "--json" for item in extra) or extra.count("--json") > 1:
        print_usage()
        return 2
    if argv[1] == "0":
        return run_phase0("--json" in extra)
    if argv[1] == "1":
        return run_phase1("--json" in extra)
    if argv[1] == "2":
        return run_phase2("--json" in extra)
    if argv[1] == "3":
        return run_phase3("--json" in extra)
    if argv[1] == "4":
        return run_phase4("--json" in extra)
    if argv[1] == "5":
        return run_phase5("--json" in extra)
    if argv[1] == "6":
        return run_phase6("--json" in extra)
    print(f"bin/check phase {argv[1]} is not implemented in Phase 01.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
