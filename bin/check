            print(json.dumps({"phase": 4, "result": "FAIL", "head": head, "errors": errors}, separators=(",", ":")))
        else:
            for error in errors:
                print(f"bin/check phase 4: {error}", file=sys.stderr)
        return 1
    if json_output:
        print(json.dumps({"phase": 4, "result": "PASS", "head": head}, separators=(",", ":")))
        print("ELEF_PHASE_4=PASS")
    else:
        print(f"Phase 04 client-library checks passed at {head}.")
    return 0


def check_phase5_ci_evidence(status: dict, head: str) -> None:
    external = os.environ.get("ELEF_GATE_EVIDENCE_DIR")
    evidence_path = (
        Path(external) / "phase-5-ci-evidence.json" if external else PHASE5_CI_EVIDENCE_PATH
    )
    evidence = read_json(evidence_path)
    if not isinstance(evidence, dict):
        fail("phase-5 CI evidence must be an object")
    run = evidence.get("run", {})
    parents = run.get("tested_merge_parents", []) or []
    if evidence.get("candidate_sha") != head and head not in parents:
        fail("phase-5 CI evidence does not name the candidate")
    if run.get("conclusion") != "success":
        fail("phase-5 CI run did not succeed")
    jobs = {job.get("name"): job.get("conclusion") for job in evidence.get("jobs", [])}
    required = (
        "desktop-fast",
        "test",
        "system-test",
        "affected",
        "sqlite-test",
        "desktop",
        "desktop-macos",
        "renderer-macos",
        "record-ci-attestation",
    )
    missing = [name for name in required if jobs.get(name) != "success"]
    if missing:
        fail(f"phase-5 CI evidence lacks successful jobs: {', '.join(missing)}")
    rail_steps = evidence.get("rails_conformance", {})
    if rail_steps.get("conclusion") != "success":
        fail("phase-5 CI evidence lacks the rails-backed conformance run")
    tauri_steps = evidence.get("tauri_conformance", {})
    if tauri_steps.get("conclusion") != "success":
        fail("phase-5 CI evidence lacks the Tauri-backed conformance run")


def check_phase5(status: dict) -> str:
    if not isinstance(status, dict):
        fail("status.json must be an object")
    head = git("rev-parse", "HEAD")
    if os.environ.get("ELEF_GATE_STATUS_PATH") or status.get("head_sha") != head:
        status = read_gate_snapshot(status, head, 5)
    if status.get("current_phase") != 5:
        fail("status.current_phase must be Phase 05")
    base = status.get("phase_base_sha")
    if not base or not is_ancestor(base, head):
        fail("status.phase_base_sha must be an ancestor of HEAD")
    if digest_file(PHASE5_PHASE_PATH) != status.get("phase_contract_sha256"):
        fail("phase contract hash differs from phases/05-settings.md")
    if digest_file(PHASE5_PLAN_PATH) != status.get("frozen_plan_sha256"):
        fail("frozen plan hash differs from execution/phase-5-plan.md")
    return head


def run_phase5(json_output: bool) -> int:
    before_status = git("status", "--porcelain", "--untracked-files=all")
    errors: list[str] = []
    head = "unknown"
    try:
        if before_status:
            fail("Phase 05 verification requires a clean candidate checkout")
        status = read_json(STATUS_PATH)
        head = check_phase5(status)
        run_tier(QUICK_COMMANDS_1, QUICK_CEILING_S, quiet=True)
        for command in ARCH_COMMANDS_1:
            run_step(command)
        run_fresh()
        check_remaining_stubs()
        check_phase5_ci_evidence(status, head)
        after_status = git("status", "--porcelain", "--untracked-files=all")
        if after_status != before_status:
            fail("Phase 05 verification changed the candidate working tree")
    except (CheckFailure, KeyError, TypeError, ValueError, OSError, json.JSONDecodeError) as error:
        errors.append(str(error))
    if errors:
        if json_output:
            print(json.dumps({"phase": 5, "result": "FAIL", "head": head, "errors": errors}, separators=(",", ":")))
        else:
            for error in errors:
                print(f"bin/check phase 5: {error}", file=sys.stderr)
        return 1
    if json_output:
        print(json.dumps({"phase": 5, "result": "PASS", "head": head}, separators=(",", ":")))
        print("ELEF_PHASE_5=PASS")
    else:
        print(f"Phase 05 settings checks passed at {head}.")
    return 0


def check_phase6_ci_evidence(status: dict, head: str) -> None:
    external = os.environ.get("ELEF_GATE_EVIDENCE_DIR")
    evidence_path = (
        Path(external) / "phase-6-ci-evidence.json" if external else PHASE6_CI_EVIDENCE_PATH
    )
    evidence = read_json(evidence_path)
    if not isinstance(evidence, dict):
        fail("phase-6 CI evidence must be an object")
    run = evidence.get("run", {})
    parents = run.get("tested_merge_parents", []) or []
    if evidence.get("candidate_sha") != head and head not in parents:
        fail("phase-6 CI evidence does not name the candidate")
    if run.get("conclusion") != "success":
        fail("phase-6 CI run did not succeed")
    jobs = {job.get("name"): job for job in evidence.get("jobs", [])}
    required = (
        "desktop-fast",
        "test",
        "system-test",
        "affected",
        "sqlite-test",
        "desktop",
        "desktop-macos",
        "renderer-macos",
        "record-ci-attestation",
    )
    missing = [name for name in required if (jobs.get(name) or {}).get("conclusion") != "success"]
    if missing:
        fail(f"phase-6 CI evidence lacks successful jobs: {', '.join(missing)}")
    for desktop_job in ("desktop", "desktop-macos"):
        if (jobs.get(desktop_job) or {}).get("shared_scenarios") != "success":
            fail(f"phase-6 CI evidence lacks shared graph scenarios on {desktop_job}")
    rail_steps = evidence.get("rails_conformance", {})
    if rail_steps.get("conclusion") != "success":
        fail("phase-6 CI evidence lacks the rails-backed conformance run")
    tauri_steps = evidence.get("tauri_conformance", {})
    if tauri_steps.get("conclusion") != "success":
        fail("phase-6 CI evidence lacks the Tauri-backed conformance run")


def check_phase6(status: dict) -> str:
    if not isinstance(status, dict):
        fail("status.json must be an object")
    head = git("rev-parse", "HEAD")
    if os.environ.get("ELEF_GATE_STATUS_PATH") or status.get("head_sha") != head:
        status = read_gate_snapshot(status, head, 6)
    if status.get("current_phase") != 6:
        fail("status.current_phase must be Phase 06")
    base = status.get("phase_base_sha")
    if not base or not is_ancestor(base, head):
        fail("status.phase_base_sha must be an ancestor of HEAD")
    if digest_file(PHASE6_PHASE_PATH) != status.get("phase_contract_sha256"):
        fail("phase contract hash differs from phases/06-graph.md")
    if digest_file(PHASE6_PLAN_PATH) != status.get("frozen_plan_sha256"):
        fail("frozen plan hash differs from execution/phase-6-plan.md")
    return head


def run_phase6(json_output: bool) -> int:
    before_status = git("status", "--porcelain", "--untracked-files=all")
    errors: list[str] = []
    head = "unknown"
    try:
        if before_status:
