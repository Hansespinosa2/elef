{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "productName": "Elef",
  "version": "0.1.0",
  "identifier": "com.elef.presentation",
  "app": {
    "windows": [{ "title": "Elef", "width": 1280, "height": 800, "resizable": true }],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:;" }
  }
}
