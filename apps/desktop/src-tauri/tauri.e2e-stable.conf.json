{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elef E2E Stable",
  "identifier": "com.elef.desktop.e2e.stable",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main-capability", "macos-updater-capability", "e2e-stable-webdriver"]
    }
  },
  "build": {
    "frontendDist": "../frontend/dist-e2e-stable"
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
