{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-dev-capability",
  "description": "Repository-Dev command set: the Stable production set plus the Dev-only document graph.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-fullscreen",
    "core:resources:allow-close",
    "allow-choose-library-root",
    "allow-get-library-status",
    "allow-read-library-config",
    "allow-write-library-config",
    "allow-read-authoring-registries",
    "allow-write-authoring-registry",
    "allow-list-work-folders",
    "allow-document-graph",
    "allow-create-work-folder",
    "allow-open-work-folder",
    "allow-read-work-folder-preview",
    "allow-read-source-snapshot",
    "allow-rename-work-folder",
    "allow-delete-work-folder",
    "allow-save-source",
    "allow-poll-file-events",
    "allow-take-snapshot",
    "allow-list-snapshots",
    "allow-restore-snapshot",
    "allow-merge-external-change",
    "allow-upload-asset",
    "allow-list-media",
    "allow-remove-media",
    "allow-import-elef-bytes",
    "allow-export-elef",
    "allow-save-pptx-bytes",
    "allow-import-elef",
    "allow-import-opened-elef",
    "allow-pending-open-elef-count",
    "allow-resolve-import-conflict",
    "allow-confirm-discard-unsaved-changes",
    "allow-export-diagnostics",
    "allow-record-preview-failure",
    "allow-record-bootstrap-failure",
    "allow-confirm-app-ready"
  ]
}
