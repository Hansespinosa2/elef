{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.elef.desktop.dev",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main-dev-capability"]
    }
  },
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist-dev",
    "beforeDevCommand": "cd ../frontend && npm run build -- --profile=dev"
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
