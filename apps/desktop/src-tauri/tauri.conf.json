{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elef",
  "version": "0.1.0",
  "identifier": "com.elef.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": {
      "script": "cd ../frontend && npm run build",
      "wait": true
    },
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elef",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main-capability", "macos-updater-capability"],
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' blob: data: asset: http://asset.localhost elefasset: http://elefasset.localhost; media-src 'self' blob: asset: http://asset.localhost elefasset: http://elefasset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["elef"],
        "name": "Elef Work",
        "description": "Portable Elef Work archive",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.elef.work",
        "exportedType": {
          "identifier": "com.elef.work",
          "conformsTo": ["public.zip-archive"]
        }
      }
    ],
    "category": "Productivity",
    "shortDescription": "Write notes and presentations in Elef",
    "longDescription": "An offline-first desktop editor for plain-folder Elef works."
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/Hansespinosa2/elef/releases/latest/download/latest.json"
      ]
    }
  }
}
