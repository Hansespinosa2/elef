# Copy to .env.development and keep the copy out of git.
# This environment is intentionally separate from the personal production
# instance: it uses port 3001 and its own PostgreSQL and storage volumes.
POSTGRES_DB=elef_development
POSTGRES_USER=elef
POSTGRES_PASSWORD=elef-development

DEV_DB_BIND_ADDRESS=127.0.0.1
DEV_DB_PORT=5433
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3001
RAILS_MAX_THREADS=3
