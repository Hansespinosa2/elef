<% content_for :title, "Settings" %>
<%= render "layouts/settings_navigation" %>
<section class="page-title mb-8">
  <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em]">Workspace defaults</p>
  <h1 class="mb-2 text-4xl font-bold">Settings</h1>
  <p class="text-[#6f675c]">New and unstyled works use these values. Each work can override them in its editor.</p>
</section>

<%= form_with model: @workspace, url: settings_path, method: :patch, class: "settings-card max-w-2xl rounded-2xl border p-6 mb-8" do |form| %>
  <div class="field mb-5">
    <%= form.label :theme, "Default theme", class: "mb-1 block font-extrabold" %>
    <%= form.select :theme, [["Match workspace", "match"], ["Light", "light"], ["Dark", "dark"]], { selected: @workspace.default_theme }, class: "settings-control w-full rounded-xl border p-3" %>
  </div>
  <div class="field mb-5">
    <%= form.label :typography, "Default typography", class: "mb-1 block font-extrabold" %>
    <%= form.select :typography, [["Book", "book"], ["Modern", "modern"], ["Technical", "technical"]], { selected: @workspace.default_typography }, class: "settings-control w-full rounded-xl border p-3" %>
  </div>
  <%= form.submit "Save workspace defaults", class: "button primary inline-flex min-h-10 cursor-pointer items-center rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white" %>
<% end %>

<article id="vim-settings" class="settings-card max-w-2xl rounded-2xl border p-6" data-controller="vim-settings">
  <div class="mb-5">
    <h2 class="text-xl font-bold">Vim settings</h2>
    <p class="text-sm text-[#aab7b1]">Configure browser-local editor preferences for Vim mode and line numbers.</p>
  </div>

  <div class="field mb-5">
    <label class="flex items-center gap-3 font-extrabold cursor-pointer">
      <input type="checkbox" data-vim-settings-target="vimToggle" data-action="change->vim-settings#toggleVim" class="rounded">
      <span>Enable Vim mode in this browser</span>
    </label>
  </div>

  <div class="field mb-5">
    <label for="vim_escape_key" class="mb-1 block font-extrabold">Remap Vim Escape</label>
    <div class="flex items-center gap-2">
      <input id="vim_escape_key" type="text" readonly placeholder="Escape (default)" data-vim-settings-target="escapeKey" data-action="keydown->vim-settings#captureEscapeKey" aria-label="Choose a key to remap Vim Escape" class="settings-control rounded-xl border p-3 max-w-xs">
      <button type="button" data-action="vim-settings#clearEscapeKey" class="button inline-flex min-h-10 cursor-pointer items-center rounded-full border border-[#304047] bg-[#202c32] px-4 py-2 font-bold text-[#e9eee9]">Clear</button>
    </div>
    <p class="field-hint">Focus the field and press a key or key combination to set it as Escape in every Vim mode.</p>
  </div>

  <div class="field mb-5">
    <label for="vim_line_numbers" class="mb-1 block font-extrabold">Line numbers</label>
    <select id="vim_line_numbers" data-vim-settings-target="lineNumbers" data-action="change->vim-settings#lineNumbersChanged" class="settings-control rounded-xl border p-3 max-w-xs">
      <option value="absolute">Absolute</option>
      <option value="relative">Relative</option>
      <option value="off">Hidden</option>
    </select>
  </div>

  <div class="field">
    <label class="flex items-center gap-3 font-extrabold cursor-pointer">
      <input type="checkbox" data-vim-settings-target="modeAwareCursor" data-action="change->vim-settings#modeAwareCursorChanged" class="rounded">
      <span>Mode-aware cursor styling</span>
    </label>
  </div>
</article>
