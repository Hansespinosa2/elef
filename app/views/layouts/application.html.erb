<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Elef" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "katex/katex.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="elef-app m-0 bg-[#f6f4ef] text-[#1e1c18] font-sans">
    <header class="app-header sticky top-0 z-10 border-b border-[#ddd5c8] bg-[rgba(255,253,248,0.94)] px-[clamp(1rem,4vw,3rem)] py-4">
      <div class="app-header-inner mx-auto flex max-w-[1440px] flex-wrap items-center gap-8">
        <div class="app-header-identity flex shrink-0 items-center">
          <%= link_to "Elef", root_path, class: "brand font-extrabold tracking-[-0.04em] no-underline", data: { turbo: false } %>
        </div>
        <nav class="app-nav mr-auto flex items-center gap-1" aria-label="Primary">
          <%= link_to "Library", root_path, class: "app-nav-link rounded-lg px-3 py-2 text-sm font-bold no-underline text-[#aab7b1] #{'is-active' if %w[library presentations documents].include?(controller_name)}" %>
          <%= link_to "Settings", settings_path, class: "app-nav-link rounded-lg px-3 py-2 text-sm font-bold no-underline text-[#aab7b1] #{'is-active' if %w[workspace_settings snippets math_shortcuts].include?(controller_name)}" %>
        </nav>
        <div class="command-palette-root" data-controller="command-palette" data-command-palette-search-url-value="<%= search_path %>" data-command-palette-commands-value="<%= json_escape([
          { id: "quick-open", label: "Quick-open works", description: "Search titles, aliases, headings, and source" },
          { id: "new-document", label: "New document", description: "Start a continuous Markdown document", url: new_document_path },
          { id: "save", label: "Save current work", description: "Submit the active editor" },
          { id: "toggle-vim", label: "Toggle Vim mode", description: "Change the active editor mode" },
          { id: "vim-settings", label: "Open Vim settings", description: "Configure the browser-local editor preferences" },
          { id: "reveal-metadata", label: "Reveal source metadata", description: "Unfold and focus Markdown front matter" },
          { id: "library-all", label: "Go to All", description: "Open the combined library", url: root_path },
          { id: "library-documents", label: "Go to Documents", description: "Open the document library", url: documents_path },
          { id: "library-presentations", label: "Go to Presentations", description: "Open the presentation library", url: presentations_path }
        ].to_json) %>">
          <button type="button" class="command-palette-trigger" data-action="command-palette#open" aria-label="Open command palette">Search <kbd>⌘K</kbd></button>
          <dialog class="command-palette" data-command-palette-target="dialog" aria-labelledby="command-palette-heading">
            <div class="command-palette-panel">
              <div class="command-palette-heading"><h2 id="command-palette-heading">Command palette</h2><button type="button" data-action="command-palette#close" aria-label="Close command palette">Esc</button></div>
              <input type="search" autocomplete="off" placeholder="Search works or run a command…" data-command-palette-target="input" data-action="input->command-palette#inputChanged keydown->command-palette#keydown" aria-controls="command-palette-results">
              <div id="command-palette-results" class="command-palette-results" data-command-palette-target="results" role="listbox" aria-label="Commands and search results"></div>
              <p class="command-palette-status" data-command-palette-target="status" aria-live="polite"></p>
            </div>
          </dialog>
        </div>
        <%= render "layouts/new_work_menu" %>
      </div>
    </header>

    <main class="app-shell mx-auto max-w-[1440px] p-[clamp(1rem,4vw,3rem)]">
      <% flash.each do |type, message| %>
        <p class="flash mb-4 rounded-2xl border border-[#f0d56b] bg-[#fff8d7] p-4 <%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
