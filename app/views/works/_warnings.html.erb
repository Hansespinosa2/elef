<% warnings = Array(warnings) %>
<section class="preview-warnings rounded-xl border border-[#e7c56d] bg-[#fff8df] p-3 text-[#765700]" data-preview-target="warnings" aria-label="Markdown warnings" <%= "hidden" if warnings.empty? %>>
  <h3 class="mb-1 text-sm font-bold">Preview warnings</h3>
  <ul class="list-disc pl-5 text-sm">
    <% warnings.each do |warning| %>
      <li><%= warning %></li>
    <% end %>
  </ul>
</section>
