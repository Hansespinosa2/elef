<% persisted = work.persisted? %>
<% type_label = work_type_label(work) %>
<% editor_map = Presentations::Document.editor_map(
  work.source.to_s.gsub(/\r\n?/, "\n"),
  source_name: work.title.presence || work.default_title,
  mode: work.work_type.to_sym
) %>
<% controllers = %w[dirty preview autosave visual-editor] %>
<% controllers << "presentation-editor" if work.presentation? %>
<% actions = ["submit->dirty#allowSubmit", "input->dirty#markDirty"] %>
<% actions += ["input->preview#schedule", "change->preview#schedule"] %>
<% actions += ["submit->autosave#submit", "input->autosave#schedule", "change->autosave#schedule", "autosave:saving->dirty#markSaving", "autosave:saved->dirty#markSaved"] %>
<% form_data = {
  controller: controllers.join(" "),
  action: actions.join(" "),
  editor_mode: "visual",
  dirty_unsaved_message_value: "You have unsaved #{type_label.downcase} changes. Leave without saving?"
} %>
<% form_data[:preview_url_value] = persisted ? work_preview_path(work) : work_preview_collection_path(work) %>
<% form_data[:visual_editor_kind_value] = work.kind %>
<% if persisted %>
  <% form_data[:autosave_work_id_value] = work.id %>
  <% form_data[:autosave_work_kind_value] = work.kind %>
  <% form_data[:autosave_work_identity_value] = work.created_at.to_f %>
<% else %>
  <% form_data[:autosave_work_kind_value] = work.kind %>
  <% form_data[:autosave_save_enabled_value] = false %>
<% end %>
<% editor_data = {
  dirty_target: "field",
  autosave_target: "field",
  snippet_palette_target: "editor",
  math_shorthand_target: "editor",
  math_shortcut_palette_target: "editor",
  editor_target: "input",
  action: "input->dirty#markDirty input->snippet-palette#input keydown->snippet-palette#keydown keydown->math-shorthand#keydown input->math-shortcut-palette#input keydown->math-shortcut-palette#keydown"
} %>
<% if work.document? %>
  <% editor_data[:document_link_palette_target] = "editor" %>
  <% editor_data[:action] += " input->document-link-palette#input keydown->document-link-palette#keydown" %>
<% end %>

<%= form_with model: work, class: "visual-editor-form", data: form_data do |form| %>
  <% if work.errors.any? %>
    <section class="error-panel rounded-2xl border border-[#efb0a8] bg-[#fff1ee] p-4 text-[#a63a2d]" aria-label="Validation errors">
      <h2><%= pluralize(work.errors.count, "error") %> prevented saving</h2>
      <ul>
        <% work.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if persisted %>
    <%= form.hidden_field :lock_version, value: work.lock_version %>
    <%= form.hidden_field :base_revision, value: work.revision_token %>
    <%= form.hidden_field :edit_session_id, value: SecureRandom.uuid %>
  <% end %>

  <section class="editor-shell" aria-label="Visual <%= type_label.downcase %> editor">
    <header class="editor-shell-header">
      <div class="editor-title-field">
        <%= form.label :title, class: "editor-title-label" %>
        <%= form.text_field :title,
          class: "editor-title-input",
          data: { dirty_target: "field", autosave_target: "field", action: "input->dirty#markDirty" },
          autocomplete: "off" %>
      </div>
      <div class="editor-kind-badge"><%= type_label %></div>
    </header>

    <div class="field appearance-fields mb-4 grid gap-3 sm:grid-cols-2">
      <div>
        <%= form.label :theme, "Theme", class: "mb-1 block font-extrabold" %>
        <%= form.select :theme,
          [["Workspace default", ""], ["Light", "light"], ["Dark", "dark"], ["Match", "match"]],
          { selected: work.theme_override },
          class: "w-full rounded-xl border border-[#ddd5c8] bg-white p-3 text-[#1e1c18]",
          data: { dirty_target: "field", autosave_target: "field", action: "change->dirty#markDirty" } %>
      </div>
      <div>
        <%= form.label :typography, "Typography", class: "mb-1 block font-extrabold" %>
        <%= form.select :typography,
          [["Workspace default", ""], ["Book", "book"], ["Modern", "modern"], ["Technical", "technical"]],
          { selected: work.typography_override },
          class: "w-full rounded-xl border border-[#ddd5c8] bg-white p-3 text-[#1e1c18]",
          data: { dirty_target: "field", autosave_target: "field", action: "change->dirty#markDirty" } %>
      </div>
      <p class="field-hint sm:col-span-2">Appearance overrides stay in the Markdown front matter.</p>
    </div>

    <div class="source-field relative" data-controller="editor snippet-palette math-shorthand math-shortcut-palette<%= " document-link-palette" if work.document? %>" data-snippet-palette-snippets-value="<%= json_escape(Snippets::Catalog.for_editor.to_json) %>" data-math-shortcut-palette-shortcuts-value="<%= json_escape(MathShortcuts::Catalog.for_editor(workspace: work.workspace || Workspace.default).to_json) %>"<% if work.document? %> data-document-link-palette-titles-value="<%= ERB::Util.html_escape(document_link_titles(workspace: work.workspace).to_json) %>"<% end %><% if work.presentation? %> data-presentation-editor-target="source"<% end %>>
      <% source_id = form.field_id(:source) %>
      <% editor_id = "#{source_id}_editor" %>
      <%= form.label :source, "Markdown source", for: source_id, id: "#{editor_id}_label", class: "sr-only" %>
      <div class="editor-toolbar" aria-label="Editor controls">
        <div class="editor-mode-switch" role="group" aria-label="Editing mode">
          <button type="button" class="editor-mode-button is-active" data-editor-target="visualButton" data-action="click->editor#showVisual" aria-pressed="true">Visual</button>
          <button type="button" class="editor-mode-button" data-editor-target="sourceButton" data-action="click->editor#showSource" aria-pressed="false">Source</button>
          <span class="editor-editing-mode" data-editor-target="editingMode" aria-live="polite">Visual</span>
        </div>
        <span class="editor-mode" data-editor-target="mode" data-mode="standard" aria-live="polite">Standard</span>
        <span class="editor-command" data-editor-target="command" aria-live="polite"></span>
        <button type="button" class="editor-reveal-metadata" data-action="editor#revealMetadata">Reveal source metadata</button>
        <details class="editor-settings ml-auto">
          <summary>Vim settings</summary>
          <div class="editor-settings-panel">
            <label class="editor-setting-row editor-setting-toggle">
              <input type="checkbox" data-editor-target="vimToggle" data-action="change->editor#toggleVim">
              <span>Enable Vim mode in this browser</span>
            </label>
            <label class="editor-setting-row">
              <span>Shift+Space in Normal mode</span>
              <select data-editor-target="mapping" data-action="change->editor#mappingChanged">
                <option value="standard">Move forward a word (standard)</option>
                <option value="insert">Enter Insert mode</option>
                <option value="disabled">Unmapped</option>
              </select>
            </label>
            <label class="editor-setting-row">
              <span>Escape aliases in Insert mode</span>
              <select data-editor-target="escapeAlias" data-action="change->editor#escapeAliasChanged">
                <option value="none">Escape only</option>
                <option value="shift-space">Escape or Shift+Space</option>
              </select>
            </label>
            <label class="editor-setting-row">
              <span>Line numbers</span>
              <select data-editor-target="lineNumbers" data-action="change->editor#lineNumbersChanged">
                <option value="absolute">Absolute</option>
                <option value="relative">Relative</option>
                <option value="off">Hidden</option>
              </select>
            </label>
            <label class="editor-setting-row editor-setting-toggle">
              <input type="checkbox" data-editor-target="modeAwareCursor" data-action="change->editor#modeAwareCursorChanged">
              <span>Mode-aware cursor styling</span>
            </label>
          </div>
        </details>
      </div>

      <div id="<%= editor_id %>" class="editor-surface" aria-labelledby="<%= editor_id %>_label" data-editor-target="surface" data-snippet-palette-target="editor" data-math-shorthand-target="editor" data-math-shortcut-palette-target="editor"></div>
      <%= form.text_area :source, rows: 24, id: source_id, class: "editor-input-proxy", spellcheck: "false", tabindex: "-1", aria: { label: "Markdown source" }, data: editor_data %>
      <div id="<%= editor_id %>_snippet_palette" class="snippet-palette" data-snippet-palette-target="palette" hidden role="listbox" aria-label="Snippet suggestions"></div>
      <div id="<%= editor_id %>_math_shortcut_palette" class="snippet-palette math-shortcut-palette" data-math-shortcut-palette-target="palette" hidden role="listbox" aria-label="Math shortcut suggestions"></div>
      <% if work.document? %><div id="<%= editor_id %>_document_link_palette" class="snippet-palette" data-document-link-palette-target="palette" hidden role="listbox" aria-label="Document link suggestions"></div><% end %>
      <p class="field-hint editor-mode-hint">Visual mode keeps Markdown source canonical. Use Source mode for unsupported syntax or to edit LaTeX expressions directly. Type <code>:trigger</code> for snippets<% if work.document? %>. Type <code>[[</code> to link another document.<% end %>. In math, type <code>@nabla</code>, <code>@frac</code>, or <code>@sum</code>; Tab walks multi-slot expressions. Exact transforms such as <code>$x.hat.b.T$</code> commit with Enter or Tab.</p>
    </div>

    <% if work.presentation? %>
      <div class="presentation-editor-tools" aria-label="Presentation editing tools">
        <span class="presentation-editor-help">Edit slide text directly. Use the controls on each slide for structure and positioning.</span>
      </div>
    <% end %>

    <script type="application/json" data-editor-map-json><%= raw json_escape(editor_map.to_json) %></script>
    <div class="editor-projection preview-pane" data-visual-editor-target="projection" data-preview-target="container" aria-label="Visual editing surface">
      <%= render "works/preview", work: work, editable: true, editor_map: editor_map %>
    </div>

    <%= render "works/warnings", warnings: work.preview_warnings %>
    <div class="editor-footer">
      <div class="editor-actions">
        <%= form.submit "Save #{type_label.downcase}", class: "button primary", data: { dirty_target: "saveButton" } %>
        <% if persisted %>
          <%= link_to "Preview", work_show_path(work), class: "button", data: { dirty_navigation: true } %>
          <span class="dirty-state" data-autosave-target="status" aria-live="polite">Saved</span>
          <button type="button" class="autosave-retry" data-autosave-target="retry" data-action="autosave#retry" hidden>Retry save</button>
          <div class="autosave-conflict" data-autosave-target="conflict" hidden role="status">
            <p data-autosave-target="conflictMessage">A newer version is active; your draft was preserved.</p>
            <details>
              <summary>Compare with the active version</summary>
              <pre data-autosave-target="serverSource"></pre>
            </details>
            <button type="button" data-action="autosave#keepLocal">Keep local draft</button>
            <button type="button" data-action="autosave#discardLocal">Discard local draft</button>
          </div>
          <% if work.presentation? %>
            <span class="release-state" data-release-status="<%= work.published_release_status %>">
              <% if work.published_release_status == "stale" %>Published release is stale — republish to present the latest draft.<% elsif work.published_release_status == "current" %>Published release is current.<% end %>
            </span>
          <% end %>
        <% else %>
          <span class="dirty-state" data-dirty-target="status" data-autosave-target="status" aria-live="polite">Saved</span>
        <% end %>
        <span class="dirty-state" data-preview-target="status" aria-live="polite"></span>
        <button type="button" class="preview-retry" data-preview-target="retry" data-action="preview#retry" hidden>Retry preview</button>
      </div>
      <% if work.presentation? %><span class="presentation-editor-status" data-presentation-editor-target="status" aria-live="polite"></span><% end %>
    </div>
  </section>
<% end %>
