<%= form_with model: math_shortcut, class: "settings-card math-shortcut-form max-w-2xl rounded-2xl border p-6" do |form| %>
  <% if math_shortcut.errors.any? %>
    <div class="error-panel mb-5 rounded-xl border border-[#efb0a8] bg-[#fff1ee] p-3 text-[#a63a2d]"><%= math_shortcut.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="field mb-4"><%= form.label :name, class: "mb-1 block font-extrabold" %><%= form.text_field :name, class: "settings-control w-full rounded-xl border p-3" %></div>
  <div class="field mb-4"><%= form.label :aliases, "Aliases", class: "mb-1 block font-extrabold" %><%= form.text_field :aliases, value: math_shortcut.aliases.join(", "), class: "settings-control w-full rounded-xl border p-3" %><p class="field-hint">Comma-separated aliases, without the leading <code>.</code> or <code>@</code>.</p></div>
  <div class="field mb-4"><%= form.label :prefix, class: "mb-1 block font-extrabold" %><%= form.select :prefix, [[". transformation", "."], ["@ alias", "@"]], {}, class: "settings-control w-full rounded-xl border p-3" %></div>
  <div class="field mb-4"><%= form.label :description, class: "mb-1 block font-extrabold" %><%= form.text_field :description, class: "settings-control w-full rounded-xl border p-3" %></div>
  <div class="field mb-5"><%= form.label :expansion, "Expansion template", class: "mb-1 block font-extrabold" %><%= form.text_field :expansion, class: "settings-control w-full rounded-xl border p-3", placeholder: '\\mathbf{${1}}' %><p class="field-hint">Use <code>${1}</code> for the selected symbol in a dot shortcut.</p></div>
  <%= form.submit math_shortcut.persisted? ? "Save shortcut" : "Create shortcut", class: "button primary inline-flex min-h-10 cursor-pointer items-center rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white" %>
<% end %>
