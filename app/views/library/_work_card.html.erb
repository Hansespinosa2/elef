<% kind = work.document? ? "document" : "presentation" %>
<% library_card_controls = Source::JavascriptRenderer.library_card_controls({
  title: work.title,
  kind: kind,
  previewUrl: work_show_path(work),
  authenticityToken: form_authenticity_token,
  rename: {
    url: work_rename_path(work),
    method: "patch",
    name: "#{work_param_key(work)}[title]",
    id: "#{work_dom_id(work)}_rename_title",
    fields: [{ name: "library_view", value: @filter }]
  },
  fork: work.presentation? ? {
    choices: [
      { label: "As continuation", url: fork_presentation_path(work), method: "post", fields: [{ name: "fork_type", value: "continuation" }] },
      { label: "As inspiration", url: fork_presentation_path(work), method: "post", fields: [{ name: "fork_type", value: "inspiration" }] }
    ]
  } : nil,
  present: work.presentation? ? { url: publish_presentation_path(work), method: "post", turbo: false } : nil,
  remove: {
    url: work_delete_path(work),
    method: "delete",
    confirm: "Delete #{work.title}?"
  }
}) %>
<% note = if work.presentation? && work.parent
  "Forked from #{work.parent.title} · #{work.fork_type}"
elsif work.presentation? && work.fork_parent_title.present?
  "Parent no longer available · #{work.fork_type}"
end %>
<%= Source::JavascriptRenderer.library_card({
  id: work_dom_id(work),
  title: work.title,
  kind: kind,
  updatedAt: work.updated_at.iso8601(3),
  editUrl: work_edit_path(work),
  previewHtml: render("library/work_preview", work: work),
  controlsHtml: library_card_controls,
  note: note
}).html_safe %>
