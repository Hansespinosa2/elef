<% current_filter = @filter || "all" %>
<% description = current_filter == "documents" ? "Long-form Markdown, gathered in one calm place." : current_filter == "presentations" ? "Slide-based Markdown, ready to shape into a story." : "One home for your documents, presentations, and source." %>
<% content_for :title, "Elef library" %>
<% library_view_config = {
  filter: current_filter,
  title: "Library",
  countLabel: pluralize(@works.size, "work"),
  description: description,
  routes: { all: root_path, documents: documents_path, presentations: presentations_path },
  searchController: true,
  empty: @works.empty?
} %>
<% actions = capture do %>
  <details class="library-tools">
    <summary class="inline-flex cursor-pointer items-center rounded-lg border border-[#304047] px-3 py-2 text-sm font-bold text-[#aab7b1]">More</summary>
    <div class="library-tools-panel absolute right-0 top-full z-10 mt-2 w-56 rounded-lg border border-[#304047] bg-[#182126] p-1 shadow-xl">
      <% if current_filter == "documents" %>
        <%= button_to "Load sample documents", load_samples_documents_path, method: :post, class: "library-tool-action block w-full rounded-lg px-3 py-2 text-left text-sm font-bold text-[#e9eee9]" %>
      <% else %>
        <%= button_to "Load sample presentations", load_samples_presentations_path, method: :post, class: "library-tool-action block w-full rounded-lg px-3 py-2 text-left text-sm font-bold text-[#e9eee9]" %>
      <% end %>
    </div>
  </details>
<% end %>
<div id="library-view-mount" data-library-view-config="<%= ERB::Util.html_escape(library_view_config.to_json) %>">
  <h1 id="library-title" class="mb-0 text-4xl font-bold">Library</h1>
  <template data-library-view-slot="actions"><%= actions %></template>
  <template data-library-view-slot="graph"><%= render "presentations/document_graph", graph: @document_graph if current_filter == "documents" && @document_graph %></template>
  <template data-library-view-slot="lineage"><%= render "presentations/lineage_graph", presentations: @lineage_presentations if @lineage_presentations.any? %></template>
  <template data-library-view-slot="cards">
    <section class="library-list" role="list" aria-label="Saved <%= current_filter %>">
      <% @works.each do |work| %><%= render "library/work_card", work: work %><% end %>
    </section>
  </template>
  <% if @works.empty? %>
    <template data-library-view-slot="empty-action"><%= button_to "Create a presentation", work_start_path(current_filter == "documents" ? "document" : "presentation"), method: :post, class: "button primary inline-flex min-h-10 cursor-pointer items-center gap-1 rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white no-underline hover:brightness-95", data: { library_empty_action: true } %></template>
  <% end %>
</div>
