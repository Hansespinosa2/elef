<div class="max-w-4xl">
  <%= render "layouts/settings_navigation" %>
  <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em]">Snippet manager</p>
  <h1 class="text-4xl font-bold"><%= heading %></h1>
  <%= form_with model: snippet, class: "settings-card mt-6 grid gap-4 rounded-2xl border p-6" do |form| %>
    <% if snippet.errors.any? %>
      <div class="error-panel rounded-xl border p-4"><%= snippet.errors.full_messages.to_sentence %></div>
    <% end %>
    <%= form.text_field :name, placeholder: "Name", required: true, class: "settings-control rounded-xl border p-3" %>
    <%= form.text_field :trigger, placeholder: "Trigger without colon, e.g. beq", required: true, class: "settings-control rounded-xl border p-3 font-mono" %>
    <%= form.text_field :description, placeholder: "Description", class: "settings-control rounded-xl border p-3" %>
    <%= form.select :category, Snippet::CATEGORIES, {}, class: "settings-control rounded-xl border p-3" %>
    <%= form.text_area :body, rows: 12, placeholder: "Markdown body. Use ${1:placeholder} for tab stops.", required: true, class: "settings-control rounded-xl border p-3 font-mono" %>
    <div class="flex gap-3">
      <%= form.submit "Save snippet", class: "button primary inline-flex min-h-10 cursor-pointer items-center rounded-full border px-4 py-2 font-bold" %>
      <%= link_to "Cancel", snippets_path, class: "button inline-flex min-h-10 items-center rounded-full border px-4 py-2 font-bold no-underline" %>
    </div>
  <% end %>
</div>
