<%= render "layouts/settings_navigation" %>

<div class="mb-8 flex items-end justify-between gap-4 max-[720px]:items-start max-[720px]:flex-col">
  <div>
    <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em]">Authoring settings</p>
    <h1 class="text-4xl font-bold">Snippets</h1>
    <p class="mt-2 text-[#aab7b1]">Reusable source templates for document content. Type <code>/trigger</code> in Source mode; use <code>:</code> for Elef directives and <code>@</code> for math constructs.</p>
  </div>
  <%= link_to "New snippet", new_snippet_path, class: "button primary inline-flex min-h-10 items-center rounded-full border px-4 py-2 font-bold no-underline" %>
</div>

<nav class="snippet-category-navigation mb-5 flex flex-wrap gap-2" aria-label="Snippet type">
  <% [["All snippets", ""], ["Markdown", "Markdown"], ["LaTeX", "LaTeX"], ["Elef directives", "Elef DSL"]].each do |label, category| %>
    <% active = @category == category %>
    <% count = category.present? ? @snippet_category_counts.fetch(category, 0) : @snippet_category_counts.values.sum %>
    <%= link_to safe_join([label, content_tag(:span, count)]), snippets_path(q: @query.presence, category: category.presence), class: "snippet-category-link #{'is-active' if active}", aria: (active ? { current: "page" } : {}) %>
  <% end %>
</nav>

<%= form_with url: snippets_path, method: :get, class: "snippet-search mb-7 flex flex-wrap gap-3" do |form| %>
  <%= form.hidden_field :category, value: @category %>
  <%= form.search_field :q, value: @query, placeholder: "Search snippets…", class: "min-w-64 flex-1 rounded-xl border p-3" %>
  <%= form.submit "Search", class: "button inline-flex min-h-10 cursor-pointer items-center rounded-full border px-4 py-2 font-bold" %>
<% end %>

<div class="snippet-groups grid gap-8">
  <% @snippet_groups.each do |category, snippets| %>
    <section aria-labelledby="snippet-category-<%= category.parameterize %>">
      <h2 id="snippet-category-<%= category.parameterize %>" class="snippet-group-heading mb-3 flex items-center gap-3 text-xl font-bold">
        <%= snippet_category_label(category) %>
        <span><%= snippets.size %></span>
      </h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% snippets.each do |snippet| %>
          <article class="snippet-card library-card rounded-2xl border p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="snippet-category-badge"><%= snippet_category_label(snippet.category) %></p>
                <h3 class="mt-1 text-2xl font-bold"><%= snippet.name %></h3>
                <p class="mt-1 text-[#aab7b1]"><code>:<%= snippet.trigger %></code> · <%= snippet.description %></p>
              </div>
              <span class="snippet-origin-badge"><%= snippet.built_in? ? "Built-in" : "Personal" %></span>
            </div>
            <div class="snippet-example mt-4">
              <p class="snippet-example-label">Template</p>
              <pre class="snippet-template overflow-auto rounded-xl p-3 text-sm"><code><%= snippet.body %></code></pre>
              <p class="snippet-example-label mt-3">Example</p>
              <div class="snippet-example-preview rounded-xl p-4">
                <%= render_markdown(snippet.display_body) %>
              </div>
            </div>
            <div class="mt-4 flex gap-3">
              <% unless snippet.built_in? %>
                <%= link_to "Edit", edit_snippet_path(snippet), class: "button inline-flex min-h-9 items-center rounded-full border px-3 py-1 font-bold no-underline" %>
                <%= button_to "Delete", snippet_path(snippet), method: :delete, class: "button inline-flex min-h-9 cursor-pointer items-center rounded-full border px-3 py-1 font-bold", form: { data: { turbo_confirm: "Delete this snippet?" } } %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

<% if @snippet_groups.empty? %>
  <div class="empty-state rounded-2xl border p-6"><p>No snippets match this search.</p></div>
<% end %>
