<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em]">Fast authoring</p>
    <h1 class="text-4xl font-bold">Snippets</h1>
    <p class="mt-2 text-[#aab7b1]">Reusable Markdown, LaTeX, and Elef source fragments.</p>
  </div>
  <%= link_to "New snippet", new_snippet_path, class: "button primary inline-flex min-h-10 items-center rounded-full border px-4 py-2 font-bold no-underline" %>
</div>

<%= form_with url: snippets_path, method: :get, class: "mb-6 flex flex-wrap gap-3" do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "Search snippets…", class: "min-w-64 flex-1 rounded-xl border border-[#304047] bg-[#11161a] p-3 text-[#e9eee9]" %>
  <%= form.select :category, options_for_select([["All categories", ""]] + Snippet::CATEGORIES.map { |category| [category, category] }, @category), {}, class: "rounded-xl border border-[#304047] bg-[#11161a] p-3 text-[#e9eee9]" %>
  <%= form.submit "Search", class: "button inline-flex min-h-10 cursor-pointer items-center rounded-full border px-4 py-2 font-bold" %>
<% end %>

<div class="grid gap-4 md:grid-cols-2">
  <% @snippets.each do |snippet| %>
    <article class="library-card rounded-2xl border p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[#9fc5a9]"><%= snippet.category %></p>
          <h2 class="mt-1 text-2xl font-bold"><%= snippet.name %></h2>
          <p class="mt-1 text-[#aab7b1]">:<%= snippet.trigger %> · <%= snippet.description %></p>
        </div>
        <span class="rounded-full border border-[#304047] px-3 py-1 text-xs"><%= snippet.built_in? ? "Built-in" : "Personal" %></span>
      </div>
      <pre class="mt-4 overflow-auto rounded-xl bg-[#11161a] p-4 text-sm"><code><%= snippet.body %></code></pre>
      <div class="snippet-preview mt-4 rounded-xl border border-[#304047] bg-[#11161a] p-4">
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-[#aab7b1]">Rendered preview</p>
        <%= render_markdown(snippet.display_body) %>
      </div>
      <div class="mt-4 flex gap-3">
        <% unless snippet.built_in? %>
          <%= link_to "Edit", edit_snippet_path(snippet), class: "button inline-flex min-h-9 items-center rounded-full border px-3 py-1 font-bold no-underline" %>
          <%= button_to "Delete", snippet_path(snippet), method: :delete, class: "button inline-flex min-h-9 cursor-pointer items-center rounded-full border px-3 py-1 font-bold", form: { data: { turbo_confirm: "Delete this snippet?" } } %>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
