<% nodes = graph[:nodes] %>
<% edges = graph[:edges] %>
<section class="document-graph-panel mt-8 rounded-2xl border border-[#ddd5c8] bg-[#fffdf8] p-5" aria-labelledby="document-graph-heading">
  <div class="mb-4 flex items-end justify-between gap-4 max-[920px]:flex-col max-[920px]:items-stretch">
    <div>
      <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#6d4aff]">Document relationships</p>
      <h2 id="document-graph-heading" class="mb-1 text-2xl font-bold">Document network</h2>
      <p class="text-[#6f675c]">Explore links authored in your Markdown. Click a document to open its preview.</p>
    </div>
    <div class="document-graph-legend text-sm text-[#6f675c]">
      <span><i class="document-graph-key-arrow"></i>Links to a document</span>
      <span><%= pluralize(nodes.length, "document") %></span>
    </div>
  </div>

  <div class="document-graph" data-controller="document-graph" data-document-graph-data-value="<%= json_escape(graph.to_json) %>">
    <div class="document-graph-navigation">
      <div class="document-graph-search">
        <label class="sr-only" for="document-graph-search">Find a document</label>
        <input id="document-graph-search" type="search" placeholder="Find a document…" data-document-graph-target="search" data-action="input->document-graph#search keydown.down->document-graph#focusResult">
        <div class="document-graph-results" data-document-graph-target="results" data-action="keydown.esc->document-graph#closeSearch" hidden></div>
      </div>
      <div class="document-graph-controls" aria-label="Graph controls">
        <button type="button" data-action="document-graph#zoomOut" aria-label="Zoom out">−</button>
        <button type="button" data-document-graph-target="scaleLabel" data-action="document-graph#reset" aria-label="Reset graph view" title="Reset to 100%">100%</button>
        <button type="button" data-action="document-graph#zoomIn" aria-label="Zoom in">+</button>
      </div>
      <span class="sr-only" aria-live="polite" data-document-graph-target="status"></span>
    </div>

    <div class="document-graph-canvas" data-document-graph-target="canvas" tabindex="0" aria-label="Document network graph">
      <svg viewBox="0 0 1000 620" role="img" aria-labelledby="document-graph-heading">
        <defs>
          <marker id="document-graph-arrow" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="strokeWidth" viewBox="0 0 10 10">
            <path d="M0,0 L10,5 L0,10 Z" fill="currentColor"></path>
          </marker>
        </defs>
        <g data-document-graph-target="viewport">
          <g class="document-graph-edges" data-document-graph-target="edges">
            <% edges.each do |edge| %>
              <line class="document-graph-edge" data-document-graph-target="edge" data-source-id="<%= edge[:source] %>" data-target-id="<%= edge[:target] %>" marker-end="url(#document-graph-arrow)"></line>
            <% end %>
          </g>
          <g class="document-graph-nodes" data-document-graph-target="nodes">
            <% nodes.each do |node| %>
              <%= link_to node[:url], class: "document-graph-node", data: { document_graph_target: "node", node_id: node[:id], title: node[:title] }, aria: { label: "Open #{node[:title]} preview" } do %>
                <circle r="14"></circle>
                <text x="22" y="5"><%= node[:title] %></text>
                <title><%= node[:title] %></title>
              <% end %>
            <% end %>
          </g>
        </g>
      </svg>
      <% if nodes.empty? %>
        <p class="document-graph-empty">Create a document to start your network.</p>
      <% end %>
    </div>
    <p class="document-graph-help">Drag the canvas to pan. Use the controls or your trackpad to zoom.</p>
  </div>
</section>
