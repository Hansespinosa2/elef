<% content_for :title, "New presentation" %>
<div class="page-title mb-8 flex items-end justify-between gap-4 max-[920px]:flex-col max-[920px]:items-stretch">
  <div>
    <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#6d4aff]">Source-first editor</p>
    <h1 class="mb-0 text-4xl font-bold">New presentation</h1>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <div data-controller="pptx-export" data-pptx-export-url-value="<%= pptx_presentations_path(version: "draft") %>" data-pptx-export-library-url-value="<%= pptx_library_path %>" data-pptx-export-current-draft-value="true">
      <button type="button" data-action="pptx-export#download" class="button inline-flex min-h-10 items-center rounded-full border border-[#ddd5c8] bg-[#fffdf8] px-4 py-2 font-bold no-underline hover:bg-[#f7efe2]">Download PPTX draft</button>
      <span class="ml-2 text-sm" role="status" aria-live="polite" data-pptx-export-target="status"></span>
    </div>
  </div>
</div>
<%= render "form", presentation: @presentation %>
