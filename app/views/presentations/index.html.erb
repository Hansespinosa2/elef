<% content_for :title, "Elef presentation library" %>
<section class="library-hero mb-8 flex items-end justify-between gap-4 max-[920px]:flex-col max-[920px]:items-stretch">
  <div>
    <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#6d4aff]">Markdown presentations</p>
    <h1 class="mb-0 text-4xl font-bold">Presentation library</h1>
    <p class="mt-2 text-[#6f675c]">Create, save, reopen, and present source-first Markdown decks.</p>
  </div>
  <div class="card-actions flex flex-wrap items-center gap-3">
    <%= button_to "Load sample presentations", load_samples_presentations_path, method: :post, class: "button inline-flex min-h-10 cursor-pointer items-center gap-1 rounded-full border border-[#ddd5c8] bg-[#fffdf8] px-4 py-2 font-bold text-[#1e1c18] no-underline hover:bg-[#f7efe2]" %>
    <%= link_to "New presentation", new_presentation_path, class: "button primary inline-flex min-h-10 items-center gap-1 rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white no-underline hover:brightness-95" %>
  </div>
</section>

<section class="library-list grid gap-4" aria-label="Saved presentations">
  <% if @presentations.any? %>
    <% @presentations.each do |presentation| %>
      <article class="library-card flex items-center justify-between rounded-2xl border border-[#ddd5c8] bg-[#fffdf8] p-5 max-[920px]:flex-col max-[920px]:items-stretch">
        <div>
          <h2 class="mb-2 text-2xl font-bold"><%= link_to presentation.title, edit_presentation_path(presentation), class: "hover:underline" %></h2>
          <p class="text-[#6f675c]"><%= pluralize(presentation.slides.length, "slide") %> · Updated <%= time_ago_in_words(presentation.updated_at) %> ago</p>
        </div>
        <div class="card-actions flex flex-wrap items-center gap-3">
          <%= link_to "Edit", edit_presentation_path(presentation), class: "hover:underline" %>
          <%= link_to "Preview", presentation_path(presentation), class: "hover:underline" %>
          <%= link_to "Present", present_presentation_path(presentation), class: "hover:underline", data: { turbo: false } %>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="empty-state flex items-center justify-between rounded-2xl border border-[#ddd5c8] bg-[#fffdf8] p-5 max-[920px]:flex-col max-[920px]:items-stretch">
      <div>
        <h2 class="mb-2 text-2xl font-bold">No presentations yet</h2>
        <p class="text-[#6f675c]">Start with Markdown. Elef stores the source and derives every slide from it.</p>
      </div>
      <%= link_to "Create your first presentation", new_presentation_path, class: "button primary inline-flex min-h-10 items-center gap-1 rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white no-underline hover:brightness-95" %>
    </div>
  <% end %>
</section>
