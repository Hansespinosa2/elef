<% content_for :title, "Elef presentation library" %>
<section class="library-hero mb-8 flex items-end justify-between gap-4 max-[920px]:flex-col max-[920px]:items-stretch">
  <div>
    <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#6d4aff]">Markdown presentations</p>
    <h1 class="mb-0 text-4xl font-bold">Presentation library</h1>
    <p class="mt-2 text-[#6f675c]">Create, save, reopen, and present source-first Markdown decks.</p>
  </div>
  <div class="card-actions flex flex-wrap items-center gap-3">
    <%= button_to "Load sample presentations", load_samples_presentations_path, method: :post, class: "button inline-flex min-h-10 cursor-pointer items-center gap-1 rounded-full border border-[#ddd5c8] bg-[#fffdf8] px-4 py-2 font-bold text-[#1e1c18] no-underline hover:bg-[#f7efe2]" %>
    <%= button_to "New presentation", start_presentations_path, method: :post, class: "button primary inline-flex min-h-10 cursor-pointer items-center gap-1 rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white no-underline hover:brightness-95" %>
  </div>
</section>

<section class="library-list grid gap-4" aria-label="Saved presentations">
  <% if @presentations.any? %>
    <% @presentations.each do |presentation| %>
      <article class="library-card flex items-center justify-between rounded-2xl border border-[#ddd5c8] bg-[#fffdf8] p-5 max-[920px]:flex-col max-[920px]:items-stretch">
        <div>
          <h2 class="mb-2 text-2xl font-bold"><%= link_to presentation.title, edit_presentation_path(presentation), class: "hover:underline" %></h2>
          <p class="text-[#6f675c]"><%= pluralize(presentation.slides.length, "slide") %> · Updated <%= time_ago_in_words(presentation.updated_at) %> ago</p>
          <% if presentation.parent %><p class="mt-1 text-sm text-[#6f675c]">Forked from <%= presentation.parent.title %> · <%= presentation.fork_type %></p><% elsif presentation.fork_parent_title.present? %><p class="mt-1 text-sm text-[#a63a2d]">Parent no longer available · <%= presentation.fork_type %></p><% end %>
        </div>
        <div class="card-actions flex flex-wrap items-center gap-3">
          <%= link_to "Edit", edit_presentation_path(presentation), class: "hover:underline" %>
          <%= link_to "Preview", presentation_path(presentation), class: "hover:underline" %>
          <%= link_to "Present", present_presentation_path(presentation), class: "hover:underline", data: { turbo: false } %>
          <%= form_with url: rename_presentation_path(presentation), method: :patch, class: "inline-flex items-center gap-2" do |form| %>
            <%= form.text_field :title, value: presentation.title, aria: { label: "Rename #{presentation.title}" }, class: "w-40 rounded-lg border border-[#ddd5c8] bg-white px-2 py-1" %>
            <%= form.submit "Rename", class: "cursor-pointer rounded-full border border-[#ddd5c8] bg-[#fffdf8] px-3 py-1 font-bold" %>
          <% end %>
          <details class="fork-menu relative">
            <summary class="cursor-pointer list-none rounded-full border border-[#ddd5c8] bg-[#fffdf8] px-3 py-1 font-bold">Fork</summary>
            <div class="fork-menu-options absolute right-0 z-10 mt-2 grid min-w-44 gap-1 rounded-xl border border-[#ddd5c8] bg-[#fffdf8] p-2 shadow-lg">
              <%= button_to "As continuation", fork_presentation_path(presentation), method: :post, params: { fork_type: "continuation" }, class: "cursor-pointer rounded-lg px-3 py-2 text-left font-bold hover:bg-[#f7efe2]" %>
              <%= button_to "As inspiration", fork_presentation_path(presentation), method: :post, params: { fork_type: "inspiration" }, class: "cursor-pointer rounded-lg px-3 py-2 text-left font-bold hover:bg-[#f7efe2]" %>
            </div>
          </details>
          <%= button_to "Delete", presentation_path(presentation), method: :delete, form: { data: { turbo_confirm: "Delete #{presentation.title}?" } }, class: "cursor-pointer rounded-full border border-[#efb0a8] bg-[#fff1ee] px-3 py-1 font-bold text-[#a63a2d]" %>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="empty-state flex items-center justify-between rounded-2xl border border-[#ddd5c8] bg-[#fffdf8] p-5 max-[920px]:flex-col max-[920px]:items-stretch">
      <div>
        <h2 class="mb-2 text-2xl font-bold">No presentations yet</h2>
        <p class="text-[#6f675c]">Start with Markdown. Elef stores the source and derives every slide from it.</p>
      </div>
      <%= button_to "Create your first presentation", start_presentations_path, method: :post, class: "button primary inline-flex min-h-10 cursor-pointer items-center gap-1 rounded-full border border-[#6d4aff] bg-[#6d4aff] px-4 py-2 font-bold text-white no-underline hover:brightness-95" %>
    </div>
  <% end %>
</section>

<%= render "lineage_graph", presentations: @presentations %>
