<% content_for :title, "Present #{@presentation.title}" %>
<div class="presentation-mode presentation-surface slides-theme-<%= @presentation.presentation_theme %> slides-typography-<%= @presentation.presentation_typography %>" data-controller="presentation" data-presentation-index-value="0">
  <% if @release_stale %>
    <p class="presentation-release-warning" role="status">This presentation is a published release. The editable draft has newer changes; republish to update what you present.</p>
  <% elsif @release.nil? %>
    <p class="presentation-release-warning" role="status">This presentation has not been published yet. Publish it from the editor to pin a release.</p>
  <% end %>
  <div class="presentation-toolbar">
    <%= link_to "Exit", presentation_path(@presentation), class: "button inline-flex min-h-10 items-center rounded-full border border-white/20 bg-white/10 px-4 py-2 font-bold text-white no-underline hover:bg-white/20", data: { turbo: false } %>
    <button type="button" class="button inline-flex min-h-10 cursor-pointer items-center rounded-full border border-white/20 bg-white/10 px-4 py-2 font-bold text-white hover:bg-white/20" data-action="presentation#previous" aria-label="Previous slide">Previous</button>
    <button type="button" class="button inline-flex min-h-10 cursor-pointer items-center rounded-full border border-white/20 bg-white/10 px-4 py-2 font-bold text-white hover:bg-white/20" data-action="presentation#next" aria-label="Next slide">Next</button>
    <button type="button" class="button inline-flex min-h-10 cursor-pointer items-center rounded-full border border-white/20 bg-white/10 px-4 py-2 font-bold text-white hover:bg-white/20" data-action="presentation#fullscreen">Fullscreen</button>
  </div>

  <div class="presentation-stage" data-presentation-target="stage" tabindex="0">
    <% @presentation.slides.each do |slide| %>
      <div class="slide-frame presentation-slide-frame" data-controller="presentation-canvas" data-presentation-target="slide">
        <%= render "slide", slide: slide, presentation: @presentation, presentation_slide: true, margin_settings: @presentation.document.margin_settings %>
      </div>
    <% end %>
  </div>
</div>
