<section class="lineage-panel mt-8 rounded-2xl border border-[#ddd5c8] bg-[#fffdf8] p-5" aria-labelledby="lineage-heading">
  <% lineage_presentations = presentations %>
  <div class="mb-4 flex items-end justify-between gap-4 max-[920px]:flex-col max-[920px]:items-stretch">
    <div>
      <p class="eyebrow mb-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#6d4aff]">Presentation relationships</p>
      <h2 id="lineage-heading" class="mb-1 text-2xl font-bold">Presentation timeline</h2>
      <p class="text-[#6f675c]">Follow a branch, browse by date, or find a presentation. Click a slide to edit it.</p>
    </div>
    <div class="lineage-legend text-sm text-[#6f675c]">
      <span><i class="lineage-key-line"></i>Continuation</span>
      <span><i class="lineage-key-line lineage-key-dotted"></i>Inspiration</span>
      <span><%= pluralize(lineage_presentations.length, "presentation") %></span>
    </div>
  </div>

  <% if lineage_presentations.any? %>
    <div class="lineage-graph lineage-graph-canvas" data-controller="lineage-graph" data-lineage-graph-target="canvas" tabindex="0" aria-label="Presentation timeline and lineage graph">
      <div class="lineage-navigation">
        <div class="lineage-search">
          <input type="search" aria-label="Find a presentation" placeholder="Find a presentation…" data-lineage-graph-target="search" data-action="input->lineage-graph#search keydown.down->lineage-graph#focusResult">
          <div class="lineage-search-results" data-lineage-graph-target="results" data-action="keydown.esc->lineage-graph#closeSearch" hidden></div>
        </div>
        <select aria-label="Jump to creation date" data-lineage-graph-target="date" data-action="change->lineage-graph#jumpToDate"></select>
        <div class="lineage-graph-controls" aria-label="Graph controls">
          <button type="button" data-action="lineage-graph#zoomOut" aria-label="Zoom out">−</button>
          <button type="button" data-lineage-graph-target="scaleLabel" data-action="lineage-graph#reset" aria-label="Reset graph view" title="Reset to 100%">100%</button>
          <button type="button" data-action="lineage-graph#zoomIn" aria-label="Zoom in">+</button>
          <button type="button" data-action="lineage-graph#fit">Overview</button>
        </div>
        <span class="sr-only" aria-live="polite" data-lineage-graph-target="status"></span>
      </div>
      <div class="lineage-timeline-scroll" data-lineage-graph-target="viewport" tabindex="0" aria-label="Scrollable presentation timeline">
        <div class="lineage-timeline-zoom" data-lineage-graph-target="zoom">
          <div class="lineage-timeline-content" data-lineage-graph-target="content">
            <div class="lineage-date-axis" data-lineage-graph-target="axis" aria-hidden="true"></div>
            <svg class="lineage-edges" data-lineage-graph-target="edges" aria-hidden="true"></svg>
            <div class="lineage-nodes" data-lineage-graph-target="nodes">
              <% lineage_presentations.each do |presentation| %>
                <% first_slide = presentation.slides.first %>
                <%= link_to edit_presentation_path(presentation),
                      class: "lineage-node lineage-#{presentation.fork_type || "root"}",
                      data: {
                        lineage_graph_target: "node",
                        lineage_graph_id: presentation.id,
                        lineage_graph_parent_id: presentation.parent_id,
                        lineage_graph_type: presentation.fork_type,
                        lineage_graph_title: presentation.title,
                        lineage_graph_created_at: presentation.created_at.iso8601(6),
                        lineage_graph_created_label: presentation.created_at.strftime("%b %-d, %Y"),
                        lineage_graph_published_at: presentation.last_published_at ? presentation.last_published_at.strftime("%b %-d, %Y") : "Never"
                      },
                      draggable: false, aria: { label: "Open #{presentation.title}" } do %>
                  <div class="lineage-slide-thumb" aria-hidden="true">
                    <div class="lineage-slide-preview presentation-surface slides slides-theme-<%= presentation.theme %> slides-typography-<%= presentation.typography %> work-theme-<%= presentation.theme %> work-typography-<%= presentation.typography %>">
                      <%= render "slide", slide: first_slide || Presentations::Document::Slide.new(id: "empty", index: 0, markdown: "", layout: "body"), presentation: presentation, margin_settings: presentation.document.margin_settings %>
                    </div>
                  </div>
                  <span class="lineage-hover-card" role="tooltip">
                    <strong><%= presentation.title %></strong>
                    <span>Created <%= presentation.created_at.strftime("%b %-d, %Y") %></span>
                    <span>Last published <%= presentation.last_published_at ? presentation.last_published_at.strftime("%b %-d, %Y") : "Never" %></span>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <p class="text-[#6f675c]">Create a presentation to start a lineage.</p>
  <% end %>
</section>
