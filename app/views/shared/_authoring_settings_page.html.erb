<%= render "layouts/settings_navigation" %>
<section
  data-controller="authoring-settings"
  data-authoring-settings-registry-value="<%= registry %>"
  data-authoring-settings-open-new-value="<%= open_new ? "true" : "false" %>"
  data-authoring-settings-entry-id-value="<%= entry_id %>"
  data-authoring-settings-snippets-url-value="<%= snippets_path(format: :json) %>"
  data-authoring-settings-math-shortcuts-url-value="<%= math_shortcuts_path(format: :json) %>"
  data-authoring-settings-close-url-value="<%= settings_path %>">
  <%= render "shared/authoring_settings_dialog" %>
</section>
