<dialog id="authoring-settings-dialog" class="authoring-settings-dialog" aria-labelledby="authoring-settings-title">
  <section class="authoring-settings-panel">
    <header class="authoring-settings-header">
      <div>
        <p class="eyebrow">AUTHORING SETTINGS</p>
        <h2 id="authoring-settings-title">Snippets</h2>
        <p class="authoring-settings-copy">Reusable snippets and math shortcuts for your editor palettes. Built-in entries are read-only.</p>
      </div>
      <button id="close-authoring-settings" class="authoring-settings-close" type="button" aria-label="Close authoring settings">×</button>
    </header>

    <div class="authoring-settings-tabs" role="tablist" aria-label="Authoring settings">
      <button class="button is-active" type="button" role="tab" data-authoring-tab="snippets" aria-selected="true">Snippets</button>
      <button class="button" type="button" role="tab" data-authoring-tab="math_shortcuts" aria-selected="false">Math shortcuts</button>
    </div>

    <div class="authoring-settings-filters">
      <label class="authoring-settings-search" for="authoring-settings-search">
        <span>Search</span>
        <input id="authoring-settings-search" type="search" autocomplete="off" placeholder="Name, trigger, or content">
      </label>
      <label id="authoring-settings-category-field" for="authoring-settings-category">
        <span>Type</span>
        <select id="authoring-settings-category">
          <option value="">All types</option>
          <option value="Markdown">Markdown</option>
          <option value="LaTeX">LaTeX</option>
          <option value="Mermaid">Mermaid</option>
          <option value="Elef DSL">Elef directives</option>
        </select>
      </label>
    </div>

    <p id="authoring-settings-status" class="authoring-settings-status" role="status" aria-live="polite"></p>
    <div class="authoring-settings-heading">
      <p id="authoring-settings-count" class="dialog-copy"></p>
      <button id="new-authoring-entry" class="button primary" type="button">New snippet</button>
    </div>
    <div id="authoring-settings-list" class="authoring-settings-list" aria-live="polite"></div>
    <p id="authoring-settings-empty" class="authoring-settings-empty" hidden>No entries match this search.</p>

    <form id="authoring-entry-form" class="authoring-entry-form" hidden>
      <h3 id="authoring-entry-heading">New snippet</h3>
      <input name="id" type="hidden">
      <fieldset class="authoring-snippet-fields" disabled>
        <label for="authoring-name">Name</label>
        <input id="authoring-name" name="name" maxlength="120" required>
        <label for="authoring-trigger">Trigger</label>
        <input id="authoring-trigger" name="trigger" maxlength="120" pattern="[a-z0-9][a-z0-9-]*" required>
        <label for="authoring-description">Description</label>
        <input id="authoring-description" name="description" maxlength="500">
        <label for="authoring-category">Category</label>
        <select id="authoring-category" name="category"><option>Markdown</option><option>LaTeX</option><option>Mermaid</option><option>Elef DSL</option></select>
        <label for="authoring-body">Body</label>
        <textarea id="authoring-body" name="body" maxlength="20000" rows="6" required></textarea>
      </fieldset>
      <fieldset class="authoring-math-fields" hidden disabled>
        <label for="authoring-math-name">Name</label>
        <input id="authoring-math-name" name="math-name" maxlength="120" required>
        <label for="authoring-prefix">Prefix</label>
        <select id="authoring-prefix" name="prefix"><option value=".">. transformation</option><option value="@">@ alias</option></select>
        <label for="authoring-aliases">Aliases</label>
        <input id="authoring-aliases" name="aliases" maxlength="1200" placeholder="lambda, l" required>
        <label for="authoring-math-description">Description</label>
        <input id="authoring-math-description" name="math-description" maxlength="500">
        <label for="authoring-expansion">Expansion template</label>
        <textarea id="authoring-expansion" name="expansion" maxlength="20000" rows="4" required></textarea>
      </fieldset>
      <div class="authoring-entry-form-actions">
        <button id="cancel-authoring-entry" class="button" type="button">Cancel</button>
        <button id="save-authoring-entry" class="button primary" type="submit">Save snippet</button>
      </div>
    </form>
  </section>
</dialog>

<dialog id="delete-authoring-dialog" class="authoring-settings-dialog authoring-delete-dialog" aria-labelledby="delete-authoring-title">
  <section class="authoring-settings-panel">
    <p class="eyebrow">AUTHORING SETTINGS</p>
    <h2 id="delete-authoring-title">Delete personal entry?</h2>
    <p id="delete-authoring-message" class="dialog-copy"></p>
    <div class="authoring-entry-form-actions">
      <button id="cancel-authoring-delete" class="button" type="button">Cancel</button>
      <button id="confirm-authoring-delete" class="button primary" type="button">Delete entry</button>
    </div>
  </section>
</dialog>
