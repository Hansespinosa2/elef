<% editable = local_assigns[:editable] || false %>
<% editor_map = local_assigns[:editor_map] %>
<div class="document-reader<%= ' document-editor-projection' if editable %>"<%= raw(' data-controller="document-pages"') unless editable %>>
  <div class="document-surface" data-document-pages-target="surface">
    <% if editable %>
      <%= Presentations::DocumentRenderer.render(
        document.source,
        source_name: document.title,
        parsed: document.parsed_document,
        documents: Document.where(workspace: document.workspace || Workspace.default),
        workspace: document.workspace || Workspace.default,
        editable: true,
        editor_map: editor_map
      ) %>
    <% else %>
      <%= document.preview_html %>
    <% end %>
  </div>
</div>
