{
  "name": "@elef/editor-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Stimulus editor-shell runtime: editor controllers, editor lib, and desktop bootstrap. Both hosts consume the narrowed boot API (registerEditorRuntime, mountEditorHosts, startFileLibraryApplication, mount tokens); per-controller deep imports are forbidden.",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./editor-chrome": {
      "types": "./src/preview_chrome.ts",
      "default": "./dist/preview_chrome.js"
    },
    "./worker": {
      "types": "./src/lib/renderer_worker.ts",
      "default": "./dist/worker.js"
    },
    "./test-internals": {
      "types": "./src/test_internals.ts",
      "default": "./dist/test_internals.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@elef/client": "0.1.0",
    "@elef/work-model": "0.1.0",
    "@hotwired/stimulus": "3.2.2",
    "@lezer/highlight": "1.2.3",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.2",
    "katex": "0.18.7"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
