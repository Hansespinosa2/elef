{
  "dependencies": {
    "@elef/contracts": "0.1.0",
    "@elef/renderer": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "description": "Complete host-neutral interactive Elef application: application shell, feature workflows, session coordination, UI primitives. Reaches environments only through @elef/contracts ports. No Rails/Tauri/filesystem/ActiveRecord knowledge, no host-name branching.",
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./preview-core": {
      "types": "./src/features/library/preview-core.ts",
      "default": "./src/features/library/preview-core.ts"
    },
    "./sanitize": {
      "types": "./src/ui/sanitize.ts",
      "default": "./dist/sanitize.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "name": "@elef/client",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "test": "node run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "0.1.0"
}
