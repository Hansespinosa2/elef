# Copy to .env.personal and keep the copy out of git.
# Use URL-safe characters in POSTGRES_PASSWORD because it is embedded in
# DATABASE_URL by compose.personal.yml.
POSTGRES_DB=elef
POSTGRES_USER=elef
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY_BASE=replace-with-the-output-of-bin-rails-secret

# Keep the app private and put a reverse proxy in front of it on a server.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
